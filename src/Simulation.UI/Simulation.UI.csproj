<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <Product>FLOW</Product>
    <Title>FLOW</Title>
    <Version>$(FlowProductVersion)</Version>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Simulation.Sprites/Simulation.Sprites.csproj" />
    <ProjectReference Include="../Simulation.Application/Simulation.Application.csproj" />
    <ProjectReference Include="../Simulation.Infrastructure/Simulation.Infrastructure.csproj" />
    <PackageReference Include="Markdig" Version="1.3.2" />
    <EmbeddedResource Include="../../docs/user-guide/**/*" Exclude="../../docs/user-guide/**/*.py" LogicalName="Guide/%(RecursiveDir)%(Filename)%(Extension)" />
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.22" />
  </ItemGroup>
  <Target Name="FlowBuildIdentity" BeforeTargets="GetAssemblyAttributes">
    <Error Condition="'$(Version)' != '$(FlowProductVersion)'" Text="FLOW version must match ProductVersion.props." />
    <Exec Command="git rev-parse HEAD" WorkingDirectory="$(MSBuildProjectDirectory)" ConsoleToMSBuild="true" IgnoreExitCode="true" StandardErrorImportance="Low" StandardOutputImportance="Low">
      <Output TaskParameter="ConsoleOutput" ItemName="FlowCommitOutput" />
      <Output TaskParameter="ExitCode" PropertyName="FlowGitExitCode" />
    </Exec>
    <Exec Condition="'$(FlowGitExitCode)' == '0'" Command="git status --porcelain --untracked-files=normal" WorkingDirectory="$(MSBuildProjectDirectory)" ConsoleToMSBuild="true" IgnoreExitCode="true" StandardOutputImportance="Low">
      <Output TaskParameter="ConsoleOutput" ItemName="FlowChangesOutput" />
    </Exec>
    <PropertyGroup>
      <FlowCommit Condition="'$(FlowGitExitCode)' == '0'">@(FlowCommitOutput)</FlowCommit>
      <FlowCommit Condition="'$(FlowGitExitCode)' != '0'">unavailable (source archive)</FlowCommit>
      <FlowSourceState Condition="'@(FlowChangesOutput)' != ''">local changes</FlowSourceState>
      <FlowSourceState Condition="'@(FlowChangesOutput)' == '' and '$(FlowGitExitCode)' == '0'">clean</FlowSourceState>
      <FlowSourceState Condition="'$(FlowGitExitCode)' != '0'">unverified</FlowSourceState>
    </PropertyGroup>
    <ItemGroup>
      <AssemblyMetadata Include="FlowPublicVersion" Value="$(FlowProductVersion)" />
      <AssemblyMetadata Include="FlowCommit" Value="$(FlowCommit)" />
      <AssemblyMetadata Include="FlowSourceState" Value="$(FlowSourceState)" />
    </ItemGroup>
  </Target>
</Project>
