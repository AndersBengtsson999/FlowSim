<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:Simulation.UI.ViewModels" xmlns:views="using:Simulation.UI.Views" xmlns:controls="using:Simulation.UI.Controls" x:Class="Simulation.UI.Views.ProductLaunchView" x:DataType="vm:LiveViewModel">
 <UserControl.Styles>
  <Style Selector="TextBlock"><Setter Property="Foreground" Value="{DynamicResource FlowText}"/></Style>
  <Style Selector="TabItem"><Setter Property="FontSize" Value="14"/><Setter Property="Foreground" Value="{DynamicResource FlowText}"/></Style>
  <Style Selector="Button"><Setter Property="Foreground" Value="{DynamicResource FlowText}"/><Setter Property="Background" Value="{DynamicResource FlowElevated}"/></Style>
 </UserControl.Styles>
 <ThemeVariantScope RequestedThemeVariant="Dark">
 <StackPanel Spacing="2">
 <Expander Name="ProductDetails" IsExpanded="{Binding ProductDetailsExpanded, Mode=TwoWay}" HorizontalAlignment="Stretch" Background="{DynamicResource FlowPanel}" Foreground="{DynamicResource FlowText}" BorderBrush="{DynamicResource FlowBorder}" Padding="0" ScrollViewer.BringIntoViewOnFocusChange="False">
  <Expander.Header><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding ProductCompactSummary}" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="12"/><TextBlock Grid.Column="1" Text="Details" Foreground="{DynamicResource FlowAccent}" Margin="12,0,0,0" VerticalAlignment="Center"/></Grid></Expander.Header>
  <StackPanel Spacing="8" Margin="10">
   <Button Content="Learn more" HorizontalAlignment="Left" AutomationProperties.Name="Learn about product versions and customer launches">
    <Button.Flyout><Flyout><StackPanel Spacing="4">
     <Button Content="Product versions" Tag="releases.versions" Click="OpenGuide"/>
     <Button Content="Internal releases and awaiting work" Tag="releases.awaiting" Click="OpenGuide"/>
     <Button Content="Manual launches" Tag="releases.manual" Click="OpenGuide"/>
     <Button Content="Scheduled launch and Postpone" Tag="releases.scheduled" Click="OpenGuide"/>
     <Button Content="Recurring launches" Tag="releases.recurring" Click="OpenGuide"/>
     <Button Content="Launch Now decisions" Tag="releases.customer-launch" Click="OpenGuide"/>
     <Button Content="Launch Economics" Tag="economics.cost-allocation" Click="OpenGuide"/>
    </StackPanel></Flyout></Button.Flyout>
   </Button>
   <TextBlock Text="{Binding ProductDecisionText}" TextWrapping="Wrap" Foreground="{DynamicResource FlowWarning}"/>
   <TextBlock Text="{Binding ProductVersionSummary}" TextWrapping="Wrap"/>
   <WrapPanel IsVisible="{Binding CanEditLaunch}">
    <ComboBox ItemsSource="{Binding LaunchModes}" SelectedItem="{Binding LaunchModeDraft, Mode=TwoWay}" Width="130" Margin="0,0,6,4" AutomationProperties.Name="Launch strategy"/>
    <TextBlock Text="Interval" VerticalAlignment="Center" Margin="0,0,6,4"/><TextBox Text="{Binding LaunchInterval, Mode=TwoWay}" Width="65" Margin="0,0,6,4" AutomationProperties.Name="Recurring launch interval"/>
    <Button Content="Apply launch strategy" Command="{Binding ConfigureLaunchCommand}" Margin="0,0,8,4"/>
   </WrapPanel>
   <TextBlock Text="Interval uses the unit and sprint length below. Apply schedules from today. Recurring restarts from actual launch day; postponing affects only the current target." TextWrapping="Wrap" FontSize="11"/>
   <WrapPanel IsVisible="{Binding CanEditLaunch}">
    <TextBox Text="{Binding VersionNameDraft, Mode=TwoWay}" Watermark="Name active version" Width="180" Margin="0,0,6,4"/><Button Content="Rename" Command="{Binding RenameVersionCommand}" Margin="0,0,12,4"/>
    <Button Content="Launch Now" Command="{Binding LaunchProductCommand}" Background="{DynamicResource FlowAccent}" Foreground="{DynamicResource FlowOnAccent}" Margin="0,0,8,4"/>
    <TextBlock Text="Plan / postpone by" VerticalAlignment="Center" Margin="0,0,6,4"/>
    <TextBox Text="{Binding LaunchDelay, Mode=TwoWay}" Width="65" Margin="0,0,6,4" AutomationProperties.Name="Launch delay"/>
    <ComboBox ItemsSource="{Binding PlanningUnits}" SelectedItem="{Binding PlanningUnit, Mode=TwoWay}" Width="135" Margin="0,0,6,4"/>
    <TextBlock Text="Days / sprint" VerticalAlignment="Center" Margin="0,0,6,4"/><TextBox Text="{Binding PlanningSprintLength, Mode=TwoWay}" Width="65" Margin="0,0,6,4" AutomationProperties.Name="Launch planning sprint length"/>
    <Button Content="Plan / Postpone Launch" Command="{Binding PlanLaunchCommand}" Margin="0,0,8,4"/>
   </WrapPanel>
   <TabControl>
    <TabItem Header="Customer delivery"><TextBlock Text="{Binding LiveCustomerSummary}" TextWrapping="Wrap" Margin="0,8"/></TabItem>
    <TabItem Header="Launch Economics"><StackPanel Spacing="6" Margin="0,8">
     <TextBlock Text="{Binding LaunchEconomicsSummary}" TextWrapping="Wrap" FontSize="12"/>
     <WrapPanel><TextBlock Text="● WIP   " Foreground="{DynamicResource FlowAccent}"/><TextBlock Text="● Awaiting launch   " Foreground="{DynamicResource FlowWarning}"/><TextBlock Text="● Total unlaunched   " Foreground="{DynamicResource FlowPurple}"/><TextBlock Text="● Customer-launched" Foreground="{DynamicResource FlowSuccess}"/></WrapPanel>
     <controls:LaunchCostChart History="{Binding LaunchCostHistory}" Height="210" AutomationProperties.Name="Launch cost allocation history in SEK"/>
    </StackPanel></TabItem>
    <TabItem Header="Launch history"><ScrollViewer MaxHeight="220"><TextBlock Text="{Binding LiveCustomerHistory}" TextWrapping="Wrap" Margin="0,8"/></ScrollViewer></TabItem>
   </TabControl>
  </StackPanel>
 </Expander>
 <views:CustomerLaunchNotice DataContext="{Binding LaunchNotices}"/>
 </StackPanel>
 </ThemeVariantScope>
</UserControl>
