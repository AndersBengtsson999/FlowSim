<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:Simulation.UI.ViewModels" xmlns:views="using:Simulation.UI.Views" xmlns:controls="using:Simulation.UI.Controls" x:Class="Simulation.UI.Views.GameView" x:DataType="vm:LiveViewModel">
 <UserControl.Styles>
  <Style Selector="Button.stationClose:focus-visible"><Setter Property="BorderBrush" Value="{DynamicResource FlowAccent}"/><Setter Property="BorderThickness" Value="2"/></Style>
 </UserControl.Styles>
 <Border Background="{DynamicResource FlowWorkshop}" CornerRadius="10" Padding="12">
  <StackPanel Spacing="8">
   <StackPanel Name="WorkshopHeader" Spacing="4">
    <Grid ColumnDefinitions="*,Auto,Auto">
     <TextBlock Text="THE SOFTWARE WORKSHOP" Foreground="{DynamicResource FlowAccent}" FontSize="19" FontWeight="Bold" VerticalAlignment="Center" TextWrapping="Wrap"/>
     <ComboBox Grid.Column="1" Name="GameRenderingMode" Margin="8,0" ItemsSource="{Binding GameRenderingModes}" SelectedItem="{Binding GameRenderingMode}" AutomationProperties.Name="Game rendering mode"/>
     <Border Grid.Column="2" Background="{DynamicResource FlowElevated}" CornerRadius="5" Padding="10,6"><TextBlock Text="{Binding DayLabel}" Foreground="{DynamicResource FlowText}" FontSize="18" FontWeight="SemiBold"/></Border>
    </Grid>
    <WrapPanel Orientation="Horizontal">
     <CheckBox Name="AnimateGameActivity" IsVisible="{Binding SpriteRendering}" Content="Animate activity" IsChecked="{Binding AnimateGameActivity}" Foreground="{DynamicResource FlowText}" Margin="0,0,14,0" AutomationProperties.Name="Animate workshop activity. Turn off to reduce motion."/>
     <CheckBox Content="Team Performance" IsChecked="{Binding DashboardVisible}" Foreground="{DynamicResource FlowText}" Margin="0,0,10,0" AutomationProperties.Name="Show Team Performance dashboard"/>
     <ComboBox Name="StationPicker" Width="190" PlaceholderText="Inspect a station" ItemsSource="{Binding #GameWorld.StationOptions}" SelectedItem="{Binding #GameWorld.SelectedStation, Mode=TwoWay}" AutomationProperties.Name="Select workshop station" Margin="0,0,10,0"/>
     <Button Classes="stationClose" Content="−" Click="ZoomOutClicked" Background="{DynamicResource FlowElevated}" Foreground="{DynamicResource FlowText}" Margin="0,0,4,0" AutomationProperties.Name="Zoom out" ToolTip.Tip="Zoom out"/>
     <TextBlock Text="{Binding #GameWorld.ZoomLabel}" Foreground="{DynamicResource FlowText}" VerticalAlignment="Center" Margin="4,0,8,0" MinWidth="38"/>
     <Button Classes="stationClose" Content="+" Click="ZoomInClicked" Background="{DynamicResource FlowElevated}" Foreground="{DynamicResource FlowText}" Margin="0,0,6,0" AutomationProperties.Name="Zoom in" ToolTip.Tip="Zoom in"/>
     <Button Classes="stationClose" Content="Fit to View" Click="FitClicked" Background="{DynamicResource FlowElevated}" Foreground="{DynamicResource FlowText}" Margin="0,0,8,0" AutomationProperties.Name="Fit workshop to view"/>
     <Button Content="Help" Click="OpenWorkshopGuide" AutomationProperties.Name="Open Game View guide"/>
    </WrapPanel>
    <Expander IsVisible="{Binding HasGuidedExperiment}" HorizontalAlignment="Stretch" Background="{DynamicResource FlowPanel}" Foreground="{DynamicResource FlowText}" Padding="8" Header="{Binding GuidedHeader}">
     <StackPanel Spacing="6">
      <TextBlock Text="{Binding GuidedProgress}" TextWrapping="Wrap"/>
      <Grid ColumnDefinitions="2*,*,*"><TextBlock Text="Matched period" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="Baseline" FontWeight="SemiBold"/><TextBlock Grid.Column="2" Text="Intervention" FontWeight="SemiBold"/></Grid>
      <ItemsControl ItemsSource="{Binding GuidedRows}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:GuidedMetricRow">
       <Grid ColumnDefinitions="2*,*,*"><TextBlock Text="{Binding Metric}"/><TextBlock Grid.Column="1" Text="{Binding Baseline}"/><TextBlock Grid.Column="2" Text="{Binding Experiment}"/></Grid>
      </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      <TextBlock Text="{Binding GuidedIncrementalShort}" TextWrapping="Wrap" FontSize="11"/>
      <Button Content="Open detailed comparison" Command="{Binding GuidedDetailsCommand}" HorizontalAlignment="Left"/>
     </StackPanel>
    </Expander>
    <views:ProductLaunchView IsVisible="{Binding HasSession}"/>
    <WrapPanel><TextBlock Margin="0,0,14,0" Text="{Binding WorkshopFeedback}" Foreground="{DynamicResource FlowText}" FontSize="12" TextWrapping="Wrap" AutomationProperties.Name="Latest simulated day feedback"/>
    <TextBlock ToolTip.Tip="{x:Static vm:QueueTrend.Method}" Name="WorkflowSummary" Text="{Binding #GameWorld.WorkflowSummary}" Foreground="{DynamicResource FlowSecondary}" FontSize="12" TextWrapping="Wrap" AutomationProperties.Name="Current workflow observations"/></WrapPanel>
   </StackPanel>
   <Grid Name="DashboardLayout" RowDefinitions="Auto,Auto" ColumnDefinitions="*">
   <Grid Name="WorkshopContent" RowDefinitions="Auto,Auto" ColumnDefinitions="*">
    <Border Name="WorldViewport" ClipToBounds="True" HorizontalAlignment="Stretch" VerticalAlignment="Top">
     <controls:GameWorldControl Name="GameWorld" CustomerLaunch="{Binding LaunchNotices.Current}" Scene="{Binding GameScene}" UseSprites="{Binding SpriteRendering}" AnimateActivity="{Binding AnimateGameActivity}" SimulationRunning="{Binding IsRunning}" PlaybackSpeed="{Binding Speed}" AutomationProperties.Name="Interactive workshop. Use arrow keys to select stations, Enter to inspect, Escape to close."/>
    </Border>
    <Border Name="StationPanel" VerticalAlignment="Top" Grid.Row="1" IsVisible="{Binding #GameWorld.HasSelection}" Background="{DynamicResource FlowPanel}" BorderBrush="{DynamicResource FlowBorder}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,10,0,0">
     <Grid RowDefinitions="Auto,Auto,*">
      <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,8">
       <TextBlock Text="{Binding #GameWorld.Details.Title}" Foreground="{DynamicResource FlowAccent}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
       <Button Grid.Column="1" Foreground="{DynamicResource FlowText}" Background="{DynamicResource FlowElevated}" Content="Info" Margin="8,0" ToolTip.Tip="{Binding #GameWorld.Details.Help}"/>
       <Button Grid.Column="2" Name="CloseStation" Classes="stationClose" Foreground="{DynamicResource FlowText}" Background="{DynamicResource FlowElevated}" Content="Close" Click="CloseStationClicked" AutomationProperties.Name="Close station details"/>
      </Grid>
      <ScrollViewer Grid.Row="1" MaxHeight="220" HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="4" Margin="0,0,0,8">
       <TextBlock Text="{Binding #GameWorld.Details.CompactSummary}" Foreground="{DynamicResource FlowText}" TextWrapping="Wrap"/>
       <TextBlock Text="{Binding #GameWorld.Inspection.MembershipNotice}" Foreground="{DynamicResource FlowSecondary}" FontSize="12" TextWrapping="Wrap"/>
       <Button Content="Learn more" Click="OpenStationGuide" HorizontalAlignment="Left"/>
         <TextBlock Name="ReleaseEconomics" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource FlowText}"/>
       <TextBlock Text="{Binding #GameWorld.Details.SnapshotSummary}" TextWrapping="Wrap" FontSize="12"/>
       <TextBlock Text="{Binding #GameWorld.Details.Condition}" Foreground="{Binding #GameWorld.Details.ConditionColor}" FontWeight="SemiBold" TextWrapping="Wrap"/>
       <TextBlock Text="{Binding #GameWorld.Details.EvidencePeriod}" FontSize="11" Foreground="{DynamicResource FlowSecondary}" TextWrapping="Wrap"/>
       <TextBlock Text="{Binding #GameWorld.Details.Observation}" FontSize="12" TextWrapping="Wrap" ToolTip.Tip="{x:Static vm:QueuePressure.Thresholds}"/>
       <Expander Header="Related KPIs · open Explorer" HorizontalAlignment="Stretch">
        <StackPanel Spacing="4">
         <TextBlock Text="Period KPIs use the selected dashboard window. Balances use the current day. Association does not prove causation." FontSize="11" TextWrapping="Wrap"/>
         <ItemsControl Name="ContextKpis"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:KpiCard">
          <Button Click="ContextKpiClicked" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="6,3" ToolTip.Tip="{Binding Help}"><StackPanel>
           <TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontSize="12"/>
           <TextBlock FontWeight="SemiBold" TextWrapping="Wrap"><Run Text="{Binding Value}"/><Run Text=" "/><Run Text="{Binding Unit}"/></TextBlock>
           <TextBlock Text="{Binding Period}" FontSize="11"/>
          </StackPanel></Button>
         </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
         <TextBlock Name="LaunchContext" Text="{Binding ProductCompactSummary}" FontSize="12" TextWrapping="Wrap"/>
         <Button Name="LaunchDetailsLink" Content="Product version / launch details" Click="LaunchDetailsClicked"/>
        </StackPanel>
       </Expander>
       <Button Name="TestingExperiment" Background="{DynamicResource FlowAccent}" Foreground="{DynamicResource FlowOnAccent}" IsVisible="{Binding #GameWorld.IsTestingSelected}" Content="Experiment with test capacity" Command="{Binding BeginGuidedCommand}" HorizontalAlignment="Left"/>
      </StackPanel></ScrollViewer>
      <ListBox Grid.Row="2" Name="InspectionList" ItemsSource="{Binding #GameWorld.Inspection.Items}" Background="Transparent" BorderThickness="0"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.IsScrollChainingEnabled="False" ScrollViewer.BringIntoViewOnFocusChange="False">
       <ListBox.Styles><Style Selector="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/></Style></ListBox.Styles>
       <ListBox.ItemTemplate><DataTemplate x:DataType="vm:InspectionItemViewModel">
        <StackPanel>
         <TextBlock IsVisible="{Binding ShowGroup}" Text="{Binding GroupHeading}" FontWeight="SemiBold" Foreground="{DynamicResource FlowWarning}" Margin="0,8,0,4"/>
         <Expander IsExpanded="{Binding Expanded, Mode=TwoWay}" HorizontalAlignment="Stretch" ScrollViewer.BringIntoViewOnFocusChange="False">
          <Expander.Header><TextBlock Text="{Binding Data.Heading}" TextWrapping="Wrap"/></Expander.Header>
          <StackPanel Background="{DynamicResource FlowPanel}" Margin="0" Spacing="2">
             <Grid ColumnDefinitions="*,*" Margin="0,2"><TextBlock Foreground="{DynamicResource FlowText}" Text="Status" TextWrapping="Wrap" Margin="0,0,8,0"/><TextBlock Foreground="{DynamicResource FlowText}" Grid.Column="1" Text="{Binding Data.Status}" TextWrapping="Wrap"/></Grid>
             <Grid ColumnDefinitions="*,*" Margin="0,2"><TextBlock Foreground="{DynamicResource FlowText}" Text="Development size" TextWrapping="Wrap" Margin="0,0,8,0"/><TextBlock Foreground="{DynamicResource FlowText}" Grid.Column="1" Text="{Binding Data.DevelopmentSize}" TextWrapping="Wrap"/></Grid>
             <Grid ColumnDefinitions="*,*" Margin="0,2"><TextBlock Foreground="{DynamicResource FlowText}" Text="Code review size" TextWrapping="Wrap" Margin="0,0,8,0"/><TextBlock Foreground="{DynamicResource FlowText}" Grid.Column="1" Text="{Binding Data.ReviewSize}" TextWrapping="Wrap"/></Grid>
             <Grid ColumnDefinitions="*,*" Margin="0,2"><TextBlock Foreground="{DynamicResource FlowText}" Text="Testing size" TextWrapping="Wrap" Margin="0,0,8,0"/><TextBlock Foreground="{DynamicResource FlowText}" Grid.Column="1" Text="{Binding Data.TestingSize}" TextWrapping="Wrap"/></Grid>
             <Grid ColumnDefinitions="*,*" Margin="0,2"><TextBlock Foreground="{DynamicResource FlowText}" Text="Days in current state" TextWrapping="Wrap" Margin="0,0,8,0"/><TextBlock Foreground="{DynamicResource FlowText}" Grid.Column="1" Text="{Binding Data.StateDays}" TextWrapping="Wrap"/></Grid>
             <Grid ColumnDefinitions="*,*" Margin="0,2"><TextBlock Foreground="{DynamicResource FlowText}" Text="Elapsed to delivery or now" TextWrapping="Wrap" Margin="0,0,8,0"/><TextBlock Foreground="{DynamicResource FlowText}" Grid.Column="1" Text="{Binding Data.ElapsedDays}" TextWrapping="Wrap"/></Grid>
             <Grid ColumnDefinitions="*,*" Margin="0,2"><TextBlock Foreground="{DynamicResource FlowText}" Text="Queue waiting" TextWrapping="Wrap" Margin="0,0,8,0"/><TextBlock Foreground="{DynamicResource FlowText}" Grid.Column="1" Text="{Binding Data.WaitingDays}" TextWrapping="Wrap"/></Grid>
             <Grid ColumnDefinitions="*,*" Margin="0,2"><TextBlock Foreground="{DynamicResource FlowText}" Text="Rework entries" TextWrapping="Wrap" Margin="0,0,8,0"/><TextBlock Foreground="{DynamicResource FlowText}" Grid.Column="1" Text="{Binding Data.ReworkEntries}" TextWrapping="Wrap"/></Grid>
             <Grid ColumnDefinitions="*,*" Margin="0,2"><TextBlock Foreground="{DynamicResource FlowText}" Text="Work received last day" TextWrapping="Wrap" Margin="0,0,8,0"/><TextBlock Foreground="{DynamicResource FlowText}" Grid.Column="1" Text="{Binding Data.RecentWork}" TextWrapping="Wrap"/></Grid>
             <Grid ColumnDefinitions="*,*" Margin="0,2"><TextBlock Foreground="{DynamicResource FlowText}" Text="Dependencies" TextWrapping="Wrap" Margin="0,0,8,0"/><TextBlock Foreground="{DynamicResource FlowText}" Grid.Column="1" Text="{Binding Data.DependencyStatus}" TextWrapping="Wrap"/></Grid>
          </StackPanel>
         </Expander>
        </StackPanel>
       </DataTemplate></ListBox.ItemTemplate>
      </ListBox>
     </Grid>
    </Border>
   </Grid>
   <views:KpiDashboardView Name="KpiPanel" Grid.Row="1" IsVisible="{Binding DashboardVisible}" VerticalAlignment="Top" Margin="0,8,0,0"/>
   </Grid>
  </StackPanel>
 </Border>
</UserControl>
