<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:Simulation.UI.ViewModels" xmlns:views="using:Simulation.UI.Views" xmlns:controls="using:Simulation.UI.Controls" x:Class="Simulation.UI.Views.GameView" x:DataType="vm:LiveViewModel">
 <UserControl.Styles>
  <Style Selector="Button.stationClose:focus-visible"><Setter Property="BorderBrush" Value="#FFEB00"/><Setter Property="BorderThickness" Value="2"/></Style>
 </UserControl.Styles>
 <Border Background="#101A25" CornerRadius="10" Padding="12">
  <StackPanel Spacing="8">
   <StackPanel Name="WorkshopHeader" Spacing="8">
    <Grid ColumnDefinitions="*,Auto,Auto">
     <TextBlock Text="THE SOFTWARE WORKSHOP" Foreground="#FFEB00" FontSize="19" FontWeight="Bold" VerticalAlignment="Center" TextWrapping="Wrap"/>
     <ComboBox Grid.Column="1" Name="GameRenderingMode" Margin="8,0" ItemsSource="{Binding GameRenderingModes}" SelectedItem="{Binding GameRenderingMode}" AutomationProperties.Name="Game rendering mode"/>
     <Border Grid.Column="2" Background="#253341" CornerRadius="5" Padding="10,6"><TextBlock Text="{Binding DayLabel}" Foreground="White" FontSize="18" FontWeight="SemiBold"/></Border>
    </Grid>
    <WrapPanel Orientation="Horizontal">
     <CheckBox Name="AnimateGameActivity" IsVisible="{Binding SpriteRendering}" Content="Animate activity" IsChecked="{Binding AnimateGameActivity}" Foreground="#D3DEE7" Margin="0,0,14,0" AutomationProperties.Name="Animate workshop activity. Turn off to reduce motion."/>
     <CheckBox Content="Team Performance" IsChecked="{Binding DashboardVisible}" Foreground="#D3DEE7" Margin="0,0,10,0" AutomationProperties.Name="Show Team Performance dashboard"/>
     <ComboBox Name="StationPicker" Width="190" PlaceholderText="Inspect a station" ItemsSource="{Binding #GameWorld.StationOptions}" SelectedItem="{Binding #GameWorld.SelectedStation, Mode=TwoWay}" AutomationProperties.Name="Select workshop station" Margin="0,0,10,0"/>
     <Button Classes="stationClose" Content="−" Click="ZoomOutClicked" Background="#243945" Foreground="#E3ECEC" Margin="0,0,4,0" AutomationProperties.Name="Zoom out" ToolTip.Tip="Zoom out"/>
     <TextBlock Text="{Binding #GameWorld.ZoomLabel}" Foreground="#E3ECEC" VerticalAlignment="Center" Margin="4,0,8,0" MinWidth="38"/>
     <Button Classes="stationClose" Content="+" Click="ZoomInClicked" Background="#243945" Foreground="#E3ECEC" Margin="0,0,6,0" AutomationProperties.Name="Zoom in" ToolTip.Tip="Zoom in"/>
     <Button Classes="stationClose" Content="Fit to View" Click="FitClicked" Background="#243945" Foreground="#E3ECEC" Margin="0,0,8,0" AutomationProperties.Name="Fit workshop to view"/>
     <Button Content="Help" Background="#243945" Foreground="#E3ECEC" BorderBrush="#6A818A" AutomationProperties.Name="Workshop help">
      <Button.Flyout><Flyout><StackPanel Spacing="8" MaxWidth="390">
       <TextBlock Text="Inspect the workshop" FontSize="17" FontWeight="Bold"/>
       <TextBlock Text="Wheel or two-finger trackpad scroll zooms around the pointer (75–250%). Drag empty scene space to pan, or middle-drag anywhere. Fit to View centers the workshop. Camera changes are immediate, without inertia. Click a station or its storage zone. You can also choose a station from the list. With the world focused, use arrow keys to select, Enter or Space to open, and Escape to close." TextWrapping="Wrap"/>
       <TextBlock Text="Counts are exact. Stacks grow nonlinearly and are bounded samples: grouped boxes do not each represent one item. ↑ growing · Ⅱ observed capacity constraint · ! zero capacity · B scheduled batch · D dependency waiting." TextWrapping="Wrap"/>
       <TextBlock Text="Figures and trips illustrate shared capacity, not individual employees. D = developer · S = specialist · T = tester. Extra team capacity is grouped rather than drawn as more people." TextWrapping="Wrap"/>
       <TextBlock Text="Packages and the vehicle replay observed events. A trip may combine release days. Motion creates no extra WIP. Above 2× speed, unnecessary trips are skipped. LIVE pause freezes animation. Station details never change or pause the simulation." TextWrapping="Wrap"/>
       <TextBlock Text="{Binding GameAnimationStatus}" TextWrapping="Wrap"/>
      </StackPanel></Flyout></Button.Flyout>
     </Button>
    </WrapPanel>
    <Expander IsVisible="{Binding HasGuidedExperiment}" HorizontalAlignment="Stretch" Background="#F5F7F8" Foreground="#17232D" Padding="8" Header="{Binding GuidedHeader}">
     <StackPanel Spacing="6">
      <TextBlock Text="{Binding GuidedProgress}" TextWrapping="Wrap"/>
      <Grid ColumnDefinitions="2*,*,*"><TextBlock Text="Matched period" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="Baseline" FontWeight="SemiBold"/><TextBlock Grid.Column="2" Text="Intervention" FontWeight="SemiBold"/></Grid>
      <ItemsControl ItemsSource="{Binding GuidedRows}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:GuidedMetricRow">
       <Grid ColumnDefinitions="2*,*,*"><TextBlock Text="{Binding Metric}"/><TextBlock Grid.Column="1" Text="{Binding Baseline}"/><TextBlock Grid.Column="2" Text="{Binding Experiment}"/></Grid>
      </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      <TextBlock Text="{Binding GuidedIncrementalShort}" TextWrapping="Wrap" FontSize="11"/>
      <Button Content="Open detailed comparison" Command="{Binding GuidedDetailsCommand}" HorizontalAlignment="Left"/>
     </StackPanel>
    </Expander>
    <TextBlock Text="{Binding WorkshopFeedback}" Foreground="#E3ECEC" FontSize="12" TextWrapping="Wrap" AutomationProperties.Name="Latest simulated day feedback"/>
    <TextBlock Name="WorkflowSummary" Text="{Binding #GameWorld.WorkflowSummary}" Foreground="#C7D8D8" FontSize="12" TextWrapping="Wrap" AutomationProperties.Name="Current workflow observations"/>
   </StackPanel>
   <Grid Name="DashboardLayout" RowDefinitions="Auto,Auto" ColumnDefinitions="*">
   <Grid Name="WorkshopContent" RowDefinitions="Auto,Auto" ColumnDefinitions="*">
    <Border Name="WorldViewport" ClipToBounds="True" HorizontalAlignment="Stretch" VerticalAlignment="Top">
     <controls:GameWorldControl Name="GameWorld" Scene="{Binding GameScene}" UseSprites="{Binding SpriteRendering}" AnimateActivity="{Binding AnimateGameActivity}" SimulationRunning="{Binding IsRunning}" PlaybackSpeed="{Binding Speed}" AutomationProperties.Name="Interactive workshop. Use arrow keys to select stations, Enter to inspect, Escape to close."/>
    </Border>
    <Border Name="StationPanel" VerticalAlignment="Top" Grid.Row="1" IsVisible="{Binding #GameWorld.HasSelection}" Background="#1B2C37" BorderBrush="#4F626A" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,10,0,0">
     <Grid RowDefinitions="Auto,*">
      <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
       <TextBlock Text="{Binding #GameWorld.Details.Title}" Foreground="#FFEB00" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
       <Button Grid.Column="1" Name="CloseStation" Classes="stationClose" Background="#243945" Foreground="#E3ECEC" BorderBrush="#6A818A" Content="Close" Click="CloseStationClicked" AutomationProperties.Name="Close station details"/>
      </Grid>
      <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
       <StackPanel Spacing="10">
        <Button Name="TestingExperiment" Background="#FFEB00" Foreground="#17232D" IsVisible="{Binding #GameWorld.IsTestingSelected}" Content="Experiment with test capacity" Command="{Binding BeginGuidedCommand}" HorizontalAlignment="Left"/>
        <ItemsControl Name="StationMetrics" ItemsSource="{Binding #GameWorld.Details.Rows}">
         <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
         <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:StationMetric">
          <Grid ColumnDefinitions="*,Auto" Margin="0,0,12,8">
           <TextBlock Text="{Binding Label}" Foreground="#BACCD4" FontSize="13" TextWrapping="Wrap" Margin="0,0,14,0"/>
           <TextBlock Grid.Column="1" Text="{Binding Value}" Foreground="White" FontSize="14" FontWeight="SemiBold" MaxWidth="240" TextWrapping="Wrap"/>
          </Grid>
         </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="{Binding #GameWorld.Details.Explanation}" Foreground="#BACCD4" FontSize="12" TextWrapping="Wrap"/>
       </StackPanel>
      </ScrollViewer>
     </Grid>
    </Border>
   </Grid>
   <views:KpiDashboardView Name="KpiPanel" Grid.Row="1" IsVisible="{Binding DashboardVisible}" VerticalAlignment="Top" Margin="0,8,0,0"/>
   </Grid>
  </StackPanel>
 </Border>
</UserControl>
