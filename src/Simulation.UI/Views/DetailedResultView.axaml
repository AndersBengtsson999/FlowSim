<UserControl xmlns="https://github.com/avaloniaui" xmlns:vm="using:Simulation.UI.ViewModels" xmlns:charts="using:Simulation.UI.Controls" xmlns:views="using:Simulation.UI.Views" xmlns:core="clr-namespace:Simulation.Core;assembly=Simulation.Core" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Simulation.UI.Views.DetailedResultView" x:DataType="vm:MainWindowViewModel">
 <UserControl.Resources>
  <vm:PresentationLabels x:Key="HumanLabel" />
 </UserControl.Resources>
 <Grid Margin="0,16,0,0">
  <TextBlock IsVisible="{Binding HasNoResults}" Text="Run Simulation to see metrics and Work Item details." Classes="note" />
  <TabControl IsVisible="{Binding HasResults}">
   <TabItem Header="Summary">
    <ScrollViewer>
     <StackPanel Spacing="12" Margin="0,12">
      <TextBlock Text="{Binding SingleRunLabel}" Classes="section" />
      <TextBlock Text="Results from the last completed run. Time averages include completed Work Items only; an empty average is shown as 0." Classes="note" />
      <ItemsControl ItemsSource="{Binding PrimaryMetrics}">
       <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:MetricRow">
         <Border Padding="14,10" Margin="0,0,0,6" ToolTip.Tip="{Binding Explanation}">
          <Grid ColumnDefinitions="*,210">
           <StackPanel Margin="0,0,16,0">
            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
           </StackPanel>
           <TextBlock Grid.Column="1" Text="{Binding Value}" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="17" />
          </Grid>
         </Border>
        </DataTemplate>
       </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Text="Largest observed queue" FontWeight="SemiBold" />
      <TextBlock Text="{Binding LargestQueue}" />
      <Expander Header="Advanced Results" HorizontalAlignment="Stretch">
       <StackPanel Spacing="10">
        <ItemsControl ItemsSource="{Binding AdvancedMetrics}">
         <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:MetricRow">
           <Border Classes="card" Padding="14,10" Margin="0,0,0,6" ToolTip.Tip="{Binding Explanation}">
            <Grid ColumnDefinitions="*,210">
             <StackPanel Margin="0,0,16,0">
              <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
              <TextBlock Text="{Binding Explanation}" Classes="note" />
             </StackPanel>
             <TextBlock Grid.Column="1" Text="{Binding Value}" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="17" />
            </Grid>
           </Border>
          </DataTemplate>
         </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="Quality &amp; Rework" Classes="section" />
        <ItemsControl ItemsSource="{Binding QualityMetrics}">
         <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:MetricRow">
           <Border Classes="card" Padding="14,10" Margin="0,0,0,6" ToolTip.Tip="{Binding Explanation}">
            <Grid ColumnDefinitions="*,210">
             <StackPanel Margin="0,0,16,0">
              <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
              <TextBlock Text="{Binding Explanation}" Classes="note" />
             </StackPanel>
             <TextBlock Grid.Column="1" Text="{Binding Value}" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="17" />
            </Grid>
           </Border>
          </DataTemplate>
         </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="High utilization is not automatically good. High WIP is not automatically bad. These metrics describe system behaviour and should be interpreted together." Classes="note" />
        <TextBlock Text="Active time + queue waiting need not equal cycle time: admitted items can stall without capacity. An end-of-day queue count can be nonzero even when admission at the next boundary gives zero elapsed queue waiting." Classes="note" />
        <ItemsControl ItemsSource="{Binding CapacityMetrics}">
         <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:MetricRow">
           <Border Classes="card" Padding="14,10" Margin="0,0,0,6" ToolTip.Tip="{Binding Explanation}">
            <Grid ColumnDefinitions="*,210">
             <StackPanel Margin="0,0,16,0">
              <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
              <TextBlock Text="{Binding Explanation}" Classes="note" />
             </StackPanel>
             <TextBlock Grid.Column="1" Text="{Binding Value}" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="17" />
            </Grid>
           </Border>
          </DataTemplate>
         </ItemsControl.ItemTemplate>
        </ItemsControl>
       </StackPanel>
      </Expander>
     </StackPanel>
    </ScrollViewer>
   </TabItem>
   <TabItem Header="Work Items">
    <Grid RowDefinitions="Auto,*" Margin="0,12">
     <TextBlock Text="Read-only results, in scenario order. Days are boundary timestamps: start 0, finish up to the horizon. Blank lead/cycle time means incomplete. Times are simulated working days." Classes="note" Margin="0,0,0,12" />
     <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
      <StackPanel MinWidth="2220">
       <Grid ColumnDefinitions="110,100,190,120,80,100,100,100,110,100,140,140,140,110,110,150,150,150" Background="#E2E8F0" Margin="0,0,0,4">
        <TextBlock Grid.Column="0" Text="Id" Margin="8" TextWrapping="Wrap" FontWeight="SemiBold" />
        <TextBlock Grid.Column="1" Text="Name" Margin="8" TextWrapping="Wrap" FontWeight="SemiBold" />
        <TextBlock Grid.Column="2" Text="Final State" Margin="8" TextWrapping="Wrap" FontWeight="SemiBold" />
        <TextBlock Grid.Column="3" Text="Development Started" Margin="8" TextWrapping="Wrap" FontWeight="SemiBold" />
        <TextBlock Grid.Column="4" Text="Done" Margin="8" TextWrapping="Wrap" FontWeight="SemiBold" />
        <TextBlock Grid.Column="5" Text="Lead Time" Margin="8" TextWrapping="Wrap" FontWeight="SemiBold" />
        <TextBlock Grid.Column="6" Text="Cycle Time" Margin="8" TextWrapping="Wrap" FontWeight="SemiBold" />
        <TextBlock Grid.Column="7" Text="Active Time" Margin="8" TextWrapping="Wrap" FontWeight="SemiBold" />
        <TextBlock Grid.Column="8" Text="Waiting Time" Margin="8" TextWrapping="Wrap" FontWeight="SemiBold" />
        <TextBlock Grid.Column="9" Text="Blocked Time" Margin="8" TextWrapping="Wrap" FontWeight="SemiBold" />
        <TextBlock Grid.Column="10" Text="Development Effort" Margin="8" TextWrapping="Wrap" FontWeight="SemiBold" />
        <TextBlock Grid.Column="11" Text="Code Review Effort" Margin="8" TextWrapping="Wrap" FontWeight="SemiBold" />
        <TextBlock Grid.Column="12" Text="Testing Effort" Margin="8" TextWrapping="Wrap" FontWeight="SemiBold" />
        <TextBlock Grid.Column="13" Text="Defects Found" Margin="8" TextWrapping="Wrap" FontWeight="SemiBold" />
        <TextBlock Grid.Column="14" Text="Rework Count" Margin="8" TextWrapping="Wrap" FontWeight="SemiBold" />
        <TextBlock Grid.Column="15" Text="Total Rework Effort" Margin="8" TextWrapping="Wrap" FontWeight="SemiBold" />
        <TextBlock Grid.Column="16" Text="Code Review Attempts" Margin="8" TextWrapping="Wrap" FontWeight="SemiBold" />
        <TextBlock Grid.Column="17" Text="Testing Attempts" Margin="8" TextWrapping="Wrap" FontWeight="SemiBold" />
       </Grid>
       <ItemsControl ItemsSource="{Binding WorkItems}">
        <ItemsControl.ItemTemplate>
         <DataTemplate x:DataType="core:WorkItemResult">
          <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
           <Grid ColumnDefinitions="110,100,190,120,80,100,100,100,110,100,140,140,140,110,110,150,150,150">
            <TextBlock Grid.Column="0" Text="{Binding Id}" Margin="8" />
            <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="8" />
            <TextBlock Grid.Column="2" Text="{Binding FinalState, Converter={StaticResource HumanLabel}}" Margin="8" />
            <TextBlock Grid.Column="3" Text="{Binding DevelopmentStartedDay}" Margin="8" />
            <TextBlock Grid.Column="4" Text="{Binding DoneDay}" Margin="8" />
            <TextBlock Grid.Column="5" Text="{Binding LeadTime}" Margin="8" />
            <TextBlock Grid.Column="6" Text="{Binding CycleTime}" Margin="8" />
            <TextBlock Grid.Column="7" Text="{Binding ActiveTime}" Margin="8" />
            <TextBlock Grid.Column="8" Text="{Binding WaitingTime}" Margin="8" />
            <TextBlock Grid.Column="9" Text="{Binding BlockedTime}" Margin="8" />
            <TextBlock Grid.Column="10" Text="{Binding DevelopmentEffort, StringFormat=0.###}" Margin="8" ToolTip.Tip="{Binding DevelopmentEffort}" />
            <TextBlock Grid.Column="11" Text="{Binding CodeReviewEffort, StringFormat=0.###}" Margin="8" ToolTip.Tip="{Binding CodeReviewEffort}" />
            <TextBlock Grid.Column="12" Text="{Binding TestingEffort, StringFormat=0.###}" Margin="8" ToolTip.Tip="{Binding TestingEffort}" />
            <TextBlock Grid.Column="13" Text="{Binding DefectsFound, StringFormat=0.###}" Margin="8" ToolTip.Tip="{Binding DefectsFound}" />
            <TextBlock Grid.Column="14" Text="{Binding ReworkCount, StringFormat=0.###}" Margin="8" ToolTip.Tip="{Binding ReworkCount}" />
            <TextBlock Grid.Column="15" Text="{Binding TotalReworkEffort, StringFormat=0.###}" Margin="8" ToolTip.Tip="{Binding TotalReworkEffort}" />
            <TextBlock Grid.Column="16" Text="{Binding CodeReviewAttempts, StringFormat=0.###}" Margin="8" ToolTip.Tip="{Binding CodeReviewAttempts}" />
            <TextBlock Grid.Column="17" Text="{Binding TestingAttempts, StringFormat=0.###}" Margin="8" ToolTip.Tip="{Binding TestingAttempts}" />
           </Grid>
          </Border>
         </DataTemplate>
        </ItemsControl.ItemTemplate>
       </ItemsControl>
      </StackPanel>
     </ScrollViewer>
    </Grid>
   </TabItem>
   <TabItem Header="Item History">
    <Grid RowDefinitions="Auto,Auto,*" Margin="0,12">
     <ComboBox ItemsSource="{Binding WorkItems}" SelectedItem="{Binding SelectedWorkItem, Mode=TwoWay}" Width="300" HorizontalAlignment="Left" AutomationProperties.Name="History Work Item">
      <ComboBox.ItemTemplate>
       <DataTemplate x:DataType="core:WorkItemResult">
        <TextBlock Text="{Binding Id}" />
       </DataTemplate>
      </ComboBox.ItemTemplate>
     </ComboBox>
     <TextBlock Grid.Row="1" Text="Boundary days are zero-based. Capacity is applied during [day, day+1); completion and defect discovery are stamped day+1. Repeated inspections and rework are retained." Classes="note" Margin="0,10" />
     <ScrollViewer Grid.Row="2">
      <ItemsControl ItemsSource="{Binding SelectedHistory}">
       <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:HistoryRow">
         <Border Background="White" Padding="10" Margin="0,0,0,3">
          <Grid ColumnDefinitions="70,*">
           <TextBlock Text="{Binding Day, StringFormat='Day {0}'}" />
           <TextBlock Grid.Column="1" Text="{Binding Description}" TextWrapping="Wrap" />
          </Grid>
         </Border>
        </DataTemplate>
       </ItemsControl.ItemTemplate>
      </ItemsControl>
     </ScrollViewer>
    </Grid>
   </TabItem>
  </TabControl>
 </Grid>
</UserControl>
