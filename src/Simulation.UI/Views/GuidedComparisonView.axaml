<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:Simulation.UI.ViewModels" xmlns:charts="using:Simulation.UI.Controls" Background="#F5F5F0" x:Class="Simulation.UI.Views.GuidedComparisonView" x:DataType="vm:LiveViewModel">
 <StackPanel Spacing="12">
  <TextBlock Text="{Binding GuidedTitle}" FontSize="24" FontWeight="Bold"/>
  <TextBlock Text="{Binding GuidedProgress}" TextWrapping="Wrap"/>
  <Button Content="Return to LIVE" Command="{Binding GuidedReturnCommand}" HorizontalAlignment="Left"/>
  <Grid ColumnDefinitions="2*,*,*,*"><TextBlock Text="Matched period"/><TextBlock Grid.Column="1" Text="Baseline"/><TextBlock Grid.Column="2" Text="Intervention"/><TextBlock Grid.Column="3" Text="Difference"/></Grid>
  <ItemsControl ItemsSource="{Binding GuidedRows}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:GuidedMetricRow">
   <Grid ColumnDefinitions="2*,*,*,*" Margin="0,4"><TextBlock Text="{Binding Metric}"/><TextBlock Grid.Column="1" Text="{Binding Baseline}"/><TextBlock Grid.Column="2" Text="{Binding Experiment}"/><TextBlock Grid.Column="3" Text="{Binding Difference}"/></Grid>
  </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  <TextBlock Text="{Binding GuidedInterpretation}" TextWrapping="Wrap"/>
  <TextBlock Text="{Binding GuidedIncrementalCost}" TextWrapping="Wrap"/>
  <TextBlock Text="Testing queue · waiting items" FontSize="18" FontWeight="SemiBold"/>
  <charts:ComparisonFlowChart Series="{Binding GuidedQueueSeries}" Height="240"/>
  <TextBlock Text="Released items" FontWeight="SemiBold"/>
  <charts:ComparisonBarChart Values="{Binding GuidedReleased}" Height="85"/>
  <TextBlock Text="Cycle time · days" FontWeight="SemiBold"/>
  <charts:ComparisonBarChart Values="{Binding GuidedCycleTime}" Height="85"/>
  <TextBlock Text="Total System Cost · consumed capacity" FontWeight="SemiBold"/>
  <charts:ComparisonBarChart Values="{Binding GuidedCost}" Height="85"/>
  <TextBlock Text="Total team cost · SEK" FontWeight="SemiBold"/>
  <charts:ComparisonBarChart Values="{Binding GuidedTeamCost}" Height="85"/>
  <TextBlock Text="{Binding EconomicAssumptions}" TextWrapping="Wrap"/>
  <TextBlock Text="{Binding GuidedMetricHelp}" TextWrapping="Wrap"/>
 </StackPanel>
</UserControl>
