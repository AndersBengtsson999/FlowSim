<UserControl xmlns="https://github.com/avaloniaui" xmlns:charts="using:Simulation.UI.Controls" xmlns:vm="using:Simulation.UI.ViewModels" xmlns:views="using:Simulation.UI.Views" xmlns:core="clr-namespace:Simulation.Core;assembly=Simulation.Core" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Simulation.UI.Views.ResultFlowView" x:DataType="vm:MainWindowViewModel">
 <UserControl.Resources>
  <vm:PresentationLabels x:Key="HumanLabel" />
 </UserControl.Resources>
 <Grid RowDefinitions="Auto,*" Margin="0,16,0,0">
  <StackPanel Spacing="6">
   <TextBlock Text="{Binding DayLabel}" Classes="section" />
   <Grid ColumnDefinitions="Auto,*,Auto" IsEnabled="{Binding HasResults}">
    <TextBlock Text="Selected Day (1–final)" VerticalAlignment="Center" />
    <Slider Grid.Column="1" Margin="16,0" Minimum="1" Maximum="{Binding LastDay}" Value="{Binding SelectedDay, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" AutomationProperties.Name="Selected Day" />
    <TextBlock Grid.Column="2" Text="{Binding LastDay}" VerticalAlignment="Center" />
   </Grid>
   <TextBlock Text="End-of-day counts. Blue = active stage; amber = waiting queue. An active-stage item may receive no capacity. Selecting a day does not rerun the simulation." Classes="note" Margin="0,0,0,12" />
   <TextBlock Text="{Binding FlowWipLimits}" Classes="note" />
   <TextBlock Text="{Binding CapacityDetail}" Classes="note" />
   <TextBlock Text="{Binding SelectedFlowDetail}" Classes="note" />
  </StackPanel>
  <TextBlock Grid.Row="1" IsVisible="{Binding HasNoResults}" Text="Run Simulation from Scenario to see the flow and daily charts." Classes="note" />
  <Grid Grid.Row="1" ColumnDefinitions="340,18,*" IsVisible="{Binding HasResults}">
   <ScrollViewer>
    <StackPanel><ListBox ItemsSource="{Binding FlowStates}" SelectedItem="{Binding SelectedFlow, Mode=TwoWay}" Background="Transparent">
     <ListBox.ItemTemplate>
      <DataTemplate x:DataType="vm:FlowStateRow">
       <StackPanel>
        <Border Background="{Binding Background}" CornerRadius="5" Padding="10,5">
         <Grid ColumnDefinitions="*,Auto">
          <StackPanel>
           <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
           <TextBlock Text="{Binding Kind}" Classes="note" TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="8,0,0,0">
           <TextBlock Text="{Binding Count}" FontSize="20" HorizontalAlignment="Right" />
           <TextBlock Text="Work Items" FontSize="10" />
          </StackPanel>
         </Grid>
        </Border>
        <ProgressBar Value="{Binding Count}" Maximum="100" Height="5" Foreground="#BD8A36" />
        <TextBlock Text="{Binding Arrow}" HorizontalAlignment="Center" Foreground="#64748B" FontSize="12" />
       </StackPanel>
      </DataTemplate>
     </ListBox.ItemTemplate>
    </ListBox>
     <Expander Header="Development allocations" HorizontalAlignment="Stretch">
      <StackPanel Spacing="6">
       <TextBlock Text="Selected day: remaining effort and capacity flow." Classes="note" />
       <ScrollViewer MaxHeight="230"><ItemsControl ItemsSource="{Binding DevelopmentAllocations}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:MetricRow">
        <StackPanel Margin="4,5" ToolTip.Tip="{Binding Explanation}"><TextBlock Text="{Binding Label}" FontWeight="SemiBold"/><TextBlock Text="{Binding Value}" TextWrapping="Wrap" FontSize="12"/></StackPanel>
       </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
      </StackPanel>
     </Expander>
</StackPanel>
   </ScrollViewer>
   <ScrollViewer Grid.Column="2">
    <StackPanel Spacing="12">
     <Border Classes="card" IsVisible="{Binding LastRunHasDefects}">
      <StackPanel Spacing="8">
       <TextBlock Text="Feedback loop · Code Review or Testing discovers a defect ↘" Classes="section" TextWrapping="Wrap" />
       <Grid ColumnDefinitions="*,30,*">
        <Border Background="#FFF2D8" Padding="12">
         <StackPanel>
          <TextBlock Text="Waiting for Rework" FontWeight="SemiBold" />
          <TextBlock Text="{Binding WaitingForReworkCount}" FontSize="22" />
          <TextBlock Text="Work Items · queue" Classes="note" />
         </StackPanel>
        </Border>
        <TextBlock Grid.Column="1" Text="→" VerticalAlignment="Center" HorizontalAlignment="Center" />
        <Border Grid.Column="2" Background="#E8F1F7" Padding="12">
         <StackPanel>
          <TextBlock Text="Rework" FontWeight="SemiBold" />
          <TextBlock Text="{Binding ReworkCount}" FontSize="22" />
          <TextBlock Text="Work Items · developer capacity" Classes="note" />
         </StackPanel>
        </Border>
       </Grid>
       <TextBlock Text="↩ Rework completed → Waiting for Code Review. The main downward flow shows successful inspections; Testing defects also return through Code Review before Testing again." Classes="note" />
      </StackPanel>
     </Border>
     <Expander Header="Work Item details · select an item" HorizontalAlignment="Stretch">
      <StackPanel Spacing="10">
       <Grid RowDefinitions="Auto,Auto,*" Margin="0,12" Height="400">
        <ComboBox ItemsSource="{Binding WorkItems}" SelectedItem="{Binding SelectedWorkItem, Mode=TwoWay}" Width="300" HorizontalAlignment="Left" AutomationProperties.Name="History Work Item">
         <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="core:WorkItemResult">
           <TextBlock Text="{Binding Id}" />
          </DataTemplate>
         </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock Grid.Row="1" Text="Boundary days are zero-based. Capacity is applied during [day, day+1); completion and defect discovery are stamped day+1. Repeated inspections and rework are retained." Classes="note" Margin="0,10" />
        <ScrollViewer Grid.Row="2">
         <ItemsControl ItemsSource="{Binding SelectedHistory}">
          <ItemsControl.ItemTemplate>
           <DataTemplate x:DataType="vm:HistoryRow">
            <Border Background="White" Padding="10" Margin="0,0,0,3">
             <Grid ColumnDefinitions="70,*">
              <TextBlock Text="{Binding Day, StringFormat='Day {0}'}" />
              <TextBlock Grid.Column="1" Text="{Binding Description}" TextWrapping="Wrap" />
             </Grid>
            </Border>
           </DataTemplate>
          </ItemsControl.ItemTemplate>
         </ItemsControl>
        </ScrollViewer>
       </Grid>
      </StackPanel>
     </Expander>
     <Expander Header="Daily charts and feedback details" HorizontalAlignment="Stretch">
      <StackPanel Spacing="10">
       <Border Classes="card">
        <StackPanel>
         <TextBlock Text="WIP over time" Classes="section" />
         <TextBlock Text="Total WIP · all started but unfinished Work Items, including queues" Classes="note" />
         <charts:DailyChart Days="{Binding Days}" SelectedDay="{Binding SelectedDay}" Mode="Wip" Height="190" />
        </StackPanel>
       </Border>
       <Border Classes="card">
        <StackPanel>
         <TextBlock Text="Queues over time" Classes="section" />
         <TextBlock Text="Blue: Waiting for Code Review · Amber: Waiting for Testing" Classes="note" />
         <charts:DailyChart Days="{Binding Days}" SelectedDay="{Binding SelectedDay}" Mode="Queues" Height="190" />
        </StackPanel>
       </Border>
       <Border Classes="card">
        <StackPanel>
         <TextBlock Text="Rework over time" Classes="section" />
         <TextBlock Text="Blue: active Rework · Amber: Waiting for Rework" Classes="note" />
         <charts:DailyChart Days="{Binding Days}" SelectedDay="{Binding SelectedDay}" Mode="ReworkStates" Height="170" />
        </StackPanel>
       </Border>
       <Border Classes="card">
        <StackPanel>
         <TextBlock Text="Daily capacity" Classes="section" />
         <TextBlock Text="Blue: used · Gray: available · abstract capacity units" Classes="note" />
         <TextBlock Text="{Binding CapacityDetail}" Classes="note" Margin="0,6" />
         <TextBlock Text="Developers · Development + Code Review + Rework" FontWeight="SemiBold" />
         <charts:DailyChart Days="{Binding Days}" SelectedDay="{Binding SelectedDay}" Mode="Developers" Height="170" />
         <TextBlock Text="Rework · part of used developer capacity" FontWeight="SemiBold" />
         <charts:DailyChart Days="{Binding Days}" SelectedDay="{Binding SelectedDay}" Mode="ReworkCapacity" Height="170" />
         <TextBlock Text="Testers · Testing" FontWeight="SemiBold" />
         <charts:DailyChart Days="{Binding Days}" SelectedDay="{Binding SelectedDay}" Mode="Testers" Height="170" />
        </StackPanel>
       </Border>
      </StackPanel>
     </Expander>
    </StackPanel>
   </ScrollViewer>
  </Grid>
 </Grid>
</UserControl>
