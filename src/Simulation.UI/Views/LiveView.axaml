<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:Simulation.UI.ViewModels" xmlns:views="using:Simulation.UI.Views" xmlns:core="using:Simulation.Core" xmlns:app="using:Simulation.Application" xmlns:charts="using:Simulation.UI.Controls" x:Class="Simulation.UI.Views.LiveView" x:DataType="vm:LiveViewModel">
 <UserControl.Styles>
  <Style Selector="ListBox#LiveFlow ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="MinHeight" Value="0"/></Style>
  <Style Selector="Button"><Setter Property="Padding" Value="10,6"/><Setter Property="Margin" Value="0,0,6,0"/></Style>
  <Style Selector="Border.interventionRow:focus-within"><Setter Property="Background" Value="{DynamicResource SystemControlHighlightListLowBrush}"/></Style>
  <Style Selector="Border.card"><Setter Property="Padding" Value="10"/></Style>
 </UserControl.Styles>
 <UserControl.Resources>
  <vm:DeliveryCostDetails x:Key="DeliveryCostDetails"/>
  <vm:InterventionPresentation x:Key="InterventionDescription"/>
  <DataTemplate x:Key="InterventionRow" x:DataType="vm:SimpleChangeField">
   <Border Classes="interventionRow" Padding="6,3" CornerRadius="4">
    <Grid ColumnDefinitions="*,84,86,24,65">
     <TextBlock Text="{Binding DisplayLabel}" ToolTip.Tip="{Binding Help}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/>
     <TextBlock Grid.Column="1" Text="{Binding CurrentDisplay}" Opacity="0.7" VerticalAlignment="Center" AutomationProperties.Name="{Binding Label, StringFormat='Current {0}'}"/>
     <TextBox Grid.Column="2" Text="{Binding Value, Mode=TwoWay}" AutomationProperties.Name="{Binding Label}" ToolTip.Tip="{Binding Help}"/>
     <TextBlock Grid.Column="3" Text="{Binding Unit}" Margin="5,0,0,0" VerticalAlignment="Center"/>
     <TextBlock Grid.Column="4" Text="Changed" IsVisible="{Binding IsChanged}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0,0,0" AutomationProperties.Name="{Binding Label, StringFormat='Changed: {0}'}"/>
    </Grid>
   </Border>
  </DataTemplate>
  <DataTemplate x:Key="StatusGroup" x:DataType="vm:MetricRow">
   <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,1,18,1" ToolTip.Tip="{Binding Explanation}">
    <TextBlock Text="{Binding Label}" Classes="metricLabel" VerticalAlignment="Center"/>
    <TextBlock Text="{Binding Value}" Classes="metricValue" VerticalAlignment="Center"/>
   </StackPanel>
  </DataTemplate>
  <DataTemplate x:Key="PerformanceMetric" x:DataType="vm:MetricRow">
   <Grid ColumnDefinitions="*,Auto" Margin="0,4" ToolTip.Tip="{Binding Explanation}">
    <TextBlock Text="{Binding Label}" TextWrapping="Wrap" Margin="0,0,12,0"/>
    <TextBlock Grid.Column="1" Text="{Binding Value}" FontWeight="SemiBold" TextAlignment="Right"/>
   </Grid>
  </DataTemplate>
  <DataTemplate x:Key="FlowRow" x:DataType="vm:FlowStateRow">
   <StackPanel>
    <ToggleButton Classes="flowDisclosure" IsChecked="{Binding IsExpanded, Mode=TwoWay}" AutomationProperties.Name="{Binding AccessibleName}" ToolTip.Tip="{Binding QueueHelp}" Classes.queueAttention="{Binding QueueAttention}" Classes.queueStrong="{Binding QueueStrong}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Classes.active="{Binding HasWipLimit}" Classes.waiting="{Binding IsWaiting}" Classes.completed="{Binding IsCompleted}" Margin="{Binding RowMargin}" MinHeight="{Binding RowMinHeight}" Padding="10,1" BorderThickness="0">
     <Grid ColumnDefinitions="185,86,*,56,24">
      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/>
      <StackPanel Grid.Column="1" IsVisible="{Binding HasWipLimit}" Spacing="3" VerticalAlignment="Center" HorizontalAlignment="Left" ToolTip.Tip="Active items / WIP limit. A fuller bar is neither better nor worse; the number remains authoritative if a limit is lowered below current WIP.">
       <TextBlock Text="{Binding WipText}" Classes="metricValue"/>
       <ProgressBar Classes="wipGauge" Value="{Binding Count}" Maximum="{Binding WipMaximum}"/>
      </StackPanel>
      <TextBlock Grid.Column="2" Text="{Binding SupportingText}" Classes="liveSecondary" IsVisible="{Binding IsNotDevelopment}" VerticalAlignment="Center" TextWrapping="Wrap"/>
      <WrapPanel Grid.Column="2" IsVisible="{Binding IsDevelopment}" VerticalAlignment="Center">
       <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,0,18,0" ToolTip.Tip="Development capacity consumed, including full collaboration consumption. Code Review and Rework also draw from the shared developer pool."><TextBlock Text="{Binding DevelopmentCapacityLabel}" Classes="metricLabel"/><TextBlock Text="{Binding DevelopmentCapacityUsed, StringFormat='{}{0:0.##}'}" Classes="metricValue"/></StackPanel>
       <StackPanel Orientation="Horizontal" Spacing="5" ToolTip.Tip="Actual Development effort reduction. Collaboration produces 50% effective work per consumed capacity unit."><TextBlock Text="{Binding DevelopmentWorkLabel}" Classes="metricLabel"/><TextBlock Text="{Binding EffectiveDevelopmentWork, StringFormat='{}{0:0.##}'}" Classes="metricValue"/></StackPanel>
       <Border Classes="specialistQueue" Classes.queueAttention="{Binding SpecialistAttention}" Classes.queueStrong="{Binding SpecialistStrong}" IsVisible="{Binding ShowSkills}" Margin="10,0,0,0" ToolTip.Tip="{Binding SpecialistHelp}" Focusable="True" AutomationProperties.Name="{Binding SpecialistHelp}"><TextBlock Text="{Binding SpecialistText}"/></Border>
      </WrapPanel>
      <TextBlock Grid.Column="3" Text="{Binding QueueCountText}" Classes="metricValue" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip.Tip="Work Items"/>
      <TextBlock Grid.Column="4" Text="{Binding DisclosureChevron}" FontSize="18" HorizontalAlignment="Right" VerticalAlignment="Center"/>
     </Grid>
    </ToggleButton>
    <StackPanel IsVisible="{Binding IsExpanded}" Margin="10,4,10,8">
     <TextBlock Text="No Work Items in this state." IsVisible="{Binding IsEmpty}" Classes="note"/>
     <ItemsControl ItemsSource="{Binding VisibleItems}">
      <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate><DataTemplate x:DataType="core:WorkItemDaySnapshot">
       <Border Classes="embeddedItem" Width="260">
        <StackPanel Spacing="2">
         <TextBlock Text="{Binding Id}" FontWeight="SemiBold" TextWrapping="Wrap" ToolTip.Tip="{Binding DeliveryCost, Converter={StaticResource DeliveryCostDetails}}"/>
         <TextBlock Text="{Binding SkillMarker}" IsVisible="{Binding RequiresSpecialist}" FontSize="11"/>
         <TextBlock Text="{Binding ImplementationSummary}" FontSize="11" TextWrapping="Wrap"/>
         <WrapPanel ToolTip.Tip="Remaining effort: Development / Code Review / Testing / Rework. Values are from the latest completed day.">
          <TextBlock Text="{Binding RemainingDevelopmentEffort, StringFormat='Dev {0:0.##}'}" Margin="0,0,8,0"/>
          <TextBlock Text="{Binding RemainingCodeReviewEffort, StringFormat='Review {0:0.##}'}" Margin="0,0,8,0"/>
          <TextBlock Text="{Binding RemainingTestingEffort, StringFormat='Test {0:0.##}'}" Margin="0,0,8,0"/>
          <TextBlock Text="{Binding RemainingReworkEffort, StringFormat='Rework {0:0.##}'}"/>
         </WrapPanel>
        </StackPanel>
       </Border>
      </DataTemplate></ItemsControl.ItemTemplate>
     </ItemsControl>
    </StackPanel>
   </StackPanel>
  </DataTemplate>
 </UserControl.Resources>
 <Grid>
 <ScrollViewer Name="LiveScroll" HorizontalScrollBarVisibility="Disabled">
 <StackPanel Spacing="8" Margin="0,4">
  <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4"><StackPanel><TextBlock Text="Live workspace" FontSize="24" FontWeight="Bold"/><TextBlock Text="Follow the work. Understand the wait." Classes="liveSecondary"/></StackPanel><Border Grid.Column="1" Background="#111111" CornerRadius="4" Padding="14,6" VerticalAlignment="Center"><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="DAY" Foreground="#FFEB00" FontSize="11" VerticalAlignment="Center"/><TextBlock Text="{Binding Day}" Foreground="White" FontSize="24" FontWeight="Bold"/></StackPanel></Border></Grid>
  <Border IsVisible="{Binding HasSession}" Classes="livePanel" AutomationProperties.Name="Live Status">
   <StackPanel Spacing="2">
    <ItemsControl ItemsSource="{Binding StatusPrimaryGroups}" ItemTemplate="{StaticResource StatusGroup}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
    <ItemsControl ItemsSource="{Binding StatusSecondaryGroups}" ItemTemplate="{StaticResource StatusGroup}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
    <TextBlock Text="{Binding LatestIntervention}" IsVisible="{Binding HasChanges}" Classes="liveSecondary" TextWrapping="Wrap"/>
   </StackPanel>
  </Border>
  <WrapPanel Name="LiveToolbar">
   <Button Content="Start" Command="{Binding StartCommand}" IsVisible="{Binding SetupVisible}" Classes="primary"/>
   <Button Content="Pause" Command="{Binding PauseCommand}" IsVisible="{Binding HasSession}"/>
   <Button Content="Resume" Command="{Binding ResumeCommand}" IsVisible="{Binding HasSession}"/>
   <Button Content="Step" Command="{Binding StepCommand}" IsVisible="{Binding HasSession}"/>
   <Button Content="Advance…" IsVisible="{Binding HasSession}" ToolTip.Tip="Advance this session to a target day while paused.">
    <Button.Flyout><Flyout><StackPanel Spacing="8">
     <TextBlock Text="Advance to Day" FontWeight="SemiBold"/>
     <TextBox Text="{Binding TargetDay, Mode=TwoWay}" Width="160" AutomationProperties.Name="Run to Day target"/>
     <Button Content="Run to Day" Command="{Binding RunToDayCommand}" AutomationProperties.Name="Run to Day"/>
    </StackPanel></Flyout></Button.Flyout>
   </Button>
   <Border Classes="toolbarSeparator" IsVisible="{Binding HasSession}"/>
   <Button Content="Change team / work" Command="{Binding ChangeCommand}" IsVisible="{Binding HasSession}" Classes="primary"/>
   <Button Content="Checkpoint" Command="{Binding CheckpointCommand}" IsVisible="{Binding HasSession}" ToolTip.Tip="Create a checkpoint. Restore and files are below the analysis sections."/>
   <Border Classes="toolbarSeparator" IsVisible="{Binding HasSession}"/>
   <TextBlock Classes="liveSecondary" Text="Speed" Margin="6,0" VerticalAlignment="Center" IsVisible="{Binding HasSession}"/>
   <ComboBox ItemsSource="{Binding Speeds}" SelectedItem="{Binding Speed, Mode=TwoWay}" Width="75" IsVisible="{Binding HasSession}"><ComboBox.ItemTemplate><DataTemplate x:DataType="x:Double"><TextBlock Text="{Binding StringFormat='{}{0}x'}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
   <Button Content="Reset" Classes="sessionReset" Command="{Binding ResetCommand}" IsVisible="{Binding HasSession}" Margin="8,0,8,0" ToolTip.Tip="Discard this timeline and its checkpoints. Save first to keep it."/>
   <TextBlock Text="{Binding PlaybackState, StringFormat='● {0}'}" Classes="liveSecondary" VerticalAlignment="Center" Margin="8,0" ToolTip.Tip="{Binding Status}" AutomationProperties.Name="Simulation state"/>
   <TextBlock Text="{Binding Status}" IsVisible="{Binding HasStatusMessage}" Classes="liveSecondary" TextWrapping="Wrap" MaxWidth="360" VerticalAlignment="Center" Margin="8,0"/>
  </WrapPanel>
  <Expander Name="SetupSection" IsExpanded="{Binding SetupExpanded, Mode=TwoWay}" HorizontalAlignment="Stretch">
   <Expander.Header><TextBlock TextWrapping="Wrap" FontSize="13"><Run Text="{Binding ConfigurationHeading}" FontWeight="SemiBold"/><Run Text="{Binding ConfigurationValues}"/></TextBlock></Expander.Header>
   <StackPanel>
  <StackPanel IsVisible="{Binding SetupVisible}" Spacing="14" MaxWidth="820" HorizontalAlignment="Stretch">
   <TextBlock Text="Start from" />
   <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding Preset, Mode=TwoWay}" MinWidth="230" />
   <TextBlock Text="People × availability → available capacity. Normal nominal capacity is 1.0 per person/day." Classes="note" TextWrapping="Wrap"/>
   <Grid ColumnDefinitions="*,24,*" RowDefinitions="Auto,Auto" MaxWidth="820" HorizontalAlignment="Stretch">
    <StackPanel Spacing="10">
     <TextBlock Text="TEAM" Classes="section" />
<Grid ColumnDefinitions="*,100"><TextBlock Text="Developers" ToolTip.Tip="{x:Static vm:FlowPresentation.DeveloperCountHelp}" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding Setup.NumberOfDevelopers, Mode=TwoWay}" AutomationProperties.Name="Live Developers" /></Grid>
<Grid ColumnDefinitions="*,100"><TextBlock Text="Specialists · of Developers" VerticalAlignment="Center" ToolTip.Tip="Subset of the total Developer count; does not add capacity."/><TextBox Grid.Column="1" Text="{Binding Setup.Specialists, Mode=TwoWay}" AutomationProperties.Name="Live Specialists"/></Grid>
<Grid ColumnDefinitions="*,100"><TextBlock Text="Specialist Work (%)" VerticalAlignment="Center" ToolTip.Tip="Probability for each new workload item. Classification is retained."/><TextBox Grid.Column="1" Text="{Binding Setup.SpecialistWorkRate, Mode=TwoWay}" AutomationProperties.Name="Live Specialist Work Rate"/></Grid>
<Grid ColumnDefinitions="*,100"><TextBlock Text="Testers" ToolTip.Tip="{x:Static vm:FlowPresentation.TesterCountHelp}" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding Setup.NumberOfTesters, Mode=TwoWay}" AutomationProperties.Name="Live Testers" /></Grid>
<TextBlock Text="AVAILABILITY" Classes="note" Margin="0,4,0,0"/>
<Grid ColumnDefinitions="*,100"><TextBlock Text="Developer Availability (%)" VerticalAlignment="Center" ToolTip.Tip="{x:Static vm:FlowPresentation.DeveloperAvailabilityHelp}"/><TextBox Grid.Column="1" Text="{Binding Setup.DeveloperAvailability, Mode=TwoWay}" AutomationProperties.Name="Developer Availability (%)" /></Grid>
<Grid ColumnDefinitions="*,100"><TextBlock Text="Tester Availability (%)" VerticalAlignment="Center" ToolTip.Tip="{x:Static vm:FlowPresentation.TesterAvailabilityHelp}"/><TextBox Grid.Column="1" Text="{Binding Setup.TesterAvailability, Mode=TwoWay}" AutomationProperties.Name="Tester Availability (%)" /></Grid>
</StackPanel><StackPanel Grid.Column="2" Spacing="10"><TextBlock Text="FLOW" Classes="section"/><Grid ColumnDefinitions="*,100"><TextBlock Text="Development WIP" VerticalAlignment="Center" ToolTip.Tip="{x:Static vm:FlowPresentation.DevelopmentWipHelp}"/><TextBox Grid.Column="1" Text="{Binding Setup.DevelopmentWipLimit, Mode=TwoWay}" AutomationProperties.Name="Live Development WIP" /></Grid>
<Grid ColumnDefinitions="*,100"><TextBlock Text="Testing WIP" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding Setup.TestingWipLimit, Mode=TwoWay}" AutomationProperties.Name="Live Testing WIP" /></Grid>
</StackPanel></Grid>
   <Expander Header="Productivity · Development / Code Review / Testing" HorizontalAlignment="Stretch"><views:ProductivitySettingsView DataContext="{Binding Setup}" /></Expander>
   <TextBlock Text="WORK" Classes="section" />
   <ComboBox ItemsSource="{Binding WorkSupplyChoices}" SelectedItem="{Binding WorkSupply, Mode=TwoWay}" IsEnabled="{Binding SupplySelectorEnabled}" AutomationProperties.Name="Work supply"/>
   <TextBlock Text="{Binding WorkSupplyHelp}" Classes="note"/>
<Grid IsVisible="{Binding ShowArrivalRate}" ColumnDefinitions="*,100"><TextBlock Text="New work · items / day" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding ArrivalRate, Mode=TwoWay}" AutomationProperties.Name="Live New work · items / day" /></Grid>

   <Expander Header="Work · effort per item" HorizontalAlignment="Stretch"><views:EffortSettingsView DataContext="{Binding Setup}" /></Expander>
   <Expander Header="Dependencies" HorizontalAlignment="Stretch"><StackPanel Spacing="6" Margin="8">
    <Grid ColumnDefinitions="*,110"><TextBlock Text="Dependency Rate (%)" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding Setup.DependencyRate, Mode=TwoWay}" AutomationProperties.Name="Dependency Rate (%)"/></Grid>
    <Grid ColumnDefinitions="*,110"><TextBlock Text="Dependency Waiting Time (days)" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding Setup.DependencyWaitingDays, Mode=TwoWay}" AutomationProperties.Name="Dependency Waiting Time (days)"/></Grid>
    <TextBlock Text="Sampled once on arrival. Waiting does not use Development WIP or capacity. Changes affect future arrivals." Classes="note" TextWrapping="Wrap"/>
   </StackPanel></Expander>
   <Expander Header="Release / Deployment" HorizontalAlignment="Stretch"><views:ReleaseSettingsView DataContext="{Binding Setup}" /></Expander>
   <Expander Header="Technical Debt" HorizontalAlignment="Stretch"><views:DebtSettingsView DataContext="{Binding Setup}" /></Expander>
   <Expander Header="Quality · defects and rework" HorizontalAlignment="Stretch"><views:LiveQualityView DataContext="{Binding Setup}" /></Expander>
   <Expander Header="More settings" HorizontalAlignment="Stretch">
    <StackPanel Spacing="12">
     <CheckBox Content="Use fixed initial backlog only" IsChecked="{Binding FixedBacklog, Mode=TwoWay}"/>
<Grid ColumnDefinitions="*,100"><TextBlock Text="Initial backlog" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding Setup.NumberOfWorkItems, Mode=TwoWay}" AutomationProperties.Name="Live Initial backlog" /></Grid>
<Grid ColumnDefinitions="*,100"><TextBlock Text="Random Seed" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding Setup.RandomSeed, Mode=TwoWay}" AutomationProperties.Name="Live Random Seed" /></Grid>
<Grid ColumnDefinitions="*,100"><TextBlock Text="Safety Limit · days" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding SafetyLimit, Mode=TwoWay}" AutomationProperties.Name="Live Safety Limit · days" /></Grid>

     <TextBlock Text="Rolling window · days" />
     <ComboBox ItemsSource="{Binding RollingWindows}" SelectedItem="{Binding RollingWindow, Mode=TwoWay}" />
     <views:LiveSettingsView DataContext="{Binding Setup}" />
    </StackPanel>
   </Expander>
   <WrapPanel><Button Content="Open Live Session" Click="OpenSession" /></WrapPanel>
  </StackPanel>
    <TextBlock IsVisible="{Binding HasSession}" Text="{Binding ConfigurationDetails}" TextWrapping="Wrap" Margin="8"/>
   </StackPanel>
  </Expander>
  <StackPanel IsVisible="{Binding HasSession}" Spacing="8">
     <Border IsVisible="{Binding IsEditing}" Classes="card" Width="600" MaxWidth="600" HorizontalAlignment="Left">
      <StackPanel Spacing="8">
       <Border Classes="sectionBand"><TextBlock Text="Paused · Change something" Classes="section" /></Border>
       <TextBlock Text="Current is read-only. Edit Try; changes take effect on the next simulated day." Classes="note" TextWrapping="Wrap"/>
       <ItemsControl ItemsSource="{Binding ChangeGroups}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:ChangeFieldGroup">
        <StackPanel Spacing="2" Margin="0,10,0,3">
         <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Margin="6,0,0,4"/>
         <Grid ColumnDefinitions="*,84,86,24,65" Margin="6,0,6,2"><TextBlock Text="PARAMETER" FontSize="10" Opacity="0.65"/><TextBlock Grid.Column="1" Text="CURRENT" FontSize="10" Opacity="0.65"/><TextBlock Grid.Column="2" Text="TRY" FontSize="10"/></Grid>
         <ItemsControl ItemsSource="{Binding Fields}" ItemTemplate="{StaticResource InterventionRow}"/>
        </StackPanel>
       </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
       <StackPanel Spacing="6" Margin="6,10,6,3">
        <TextBlock Text="Release / Deployment" FontWeight="SemiBold"/>
        <Grid ColumnDefinitions="*,130,145,90"><TextBlock Text="PARAMETER" FontSize="10"/><TextBlock Grid.Column="1" Text="CURRENT" FontSize="10"/><TextBlock Grid.Column="2" Text="TRY" FontSize="10"/></Grid>
        <Grid ColumnDefinitions="*,130,145,90"><TextBlock Text="Release Mode" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding CurrentReleaseMode}" VerticalAlignment="Center" Opacity="0.7"/><ComboBox Grid.Column="2" ItemsSource="{Binding Draft.ReleaseModes}" SelectedItem="{Binding Draft.ReleaseMode, Mode=TwoWay}" AutomationProperties.Name="Change Release Mode"/></Grid>
        <Grid ColumnDefinitions="*,130,145,90"><TextBlock Text="Release Capacity" VerticalAlignment="Center"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding CurrentReleaseCapacity}" Opacity="0.7"/><TextBlock Text="{Binding CurrentReleaseUnit}" FontSize="10" Opacity="0.7"/></StackPanel><TextBox Grid.Column="2" Text="{Binding Draft.ReleaseCapacity, Mode=TwoWay}" AutomationProperties.Name="Change Release Capacity"/><TextBlock Grid.Column="3" Text="{Binding Draft.ReleaseCapacityUnit}" FontSize="11" Margin="5,0" VerticalAlignment="Center"/></Grid>
        <Grid ColumnDefinitions="*,130,145,90" IsVisible="{Binding Draft.ScheduledRelease}"><TextBlock Text="Release Interval" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding CurrentReleaseInterval}" VerticalAlignment="Center" Opacity="0.7"/><TextBox Grid.Column="2" Text="{Binding Draft.ReleaseInterval, Mode=TwoWay}" AutomationProperties.Name="Change Release Interval"/><TextBlock Grid.Column="3" Text="days" Margin="5,0" VerticalAlignment="Center"/></Grid>
       </StackPanel>
       <Expander Header="Advanced · Technical Debt" HorizontalAlignment="Stretch">
        <StackPanel Spacing="6"><TextBlock Text="Calibration assumption: debt created per unit of shortcut effort saved. Applies to future Development starts." Classes="note" TextWrapping="Wrap"/>
         <ItemsControl ItemsSource="{Binding AdvancedDebtChanges}" ItemTemplate="{StaticResource InterventionRow}"/>
        </StackPanel>
       </Expander>
       <TextBlock Text="Optional label"/><TextBox Text="{Binding ChangeLabel, Mode=TwoWay}" MaxLength="100" AutomationProperties.Name="Change label" />
       <TextBlock Text="Work supply"/>
       <ComboBox ItemsSource="{Binding ArrivalModes}" SelectedItem="{Binding DraftSupply, Mode=TwoWay}" AutomationProperties.Name="Change Work supply"/>
       <Grid ColumnDefinitions="*,100" IsVisible="{Binding ShowDraftArrivalRate}"><TextBlock Text="Items / day"/><TextBox Grid.Column="1" Text="{Binding DraftArrivalRate, Mode=TwoWay}" AutomationProperties.Name="New Work / day"/></Grid>
       <Expander Header="More things to change"><StackPanel Spacing="8"><TextBlock Text="{Binding CurrentQuality}" Classes="note"/><views:LiveQualityView DataContext="{Binding Draft}" /></StackPanel></Expander>
       <WrapPanel><Button Content="Apply Changes" Command="{Binding ApplyCommand}" Classes="primary"/><Button Content="Cancel" Command="{Binding CancelChangeCommand}" /></WrapPanel>
      </StackPanel>
     </Border>
   <StackPanel IsVisible="{Binding DebtVisible}" Spacing="0" Margin="4,0" ToolTip.Tip="{Binding DebtDetails}">
    <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding DebtText}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/><Button Grid.Column="1" Content="Details" Padding="5,0" MinHeight="20" Margin="8,0,0,0"><Button.Flyout><Flyout><TextBlock Text="{Binding DebtDetails}" TextWrapping="Wrap" MaxWidth="500"/></Flyout></Button.Flyout></Button></Grid>
    <charts:TechnicalDebtBar State="{Binding DebtBar}" Height="32" AutomationProperties.Name="{Binding DebtText}"/>
   </StackPanel>
   <Border Classes="sectionBand"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Flow Board" Classes="liveSection"/><TextBlock Grid.Column="1" Text="Work Items" Foreground="#111111" FontSize="12" Margin="0,0,30,0"/></Grid></Border>
   <Border Background="White" Padding="12,8" CornerRadius="4"><Grid ColumnDefinitions="*,Auto,*,Auto,*,Auto,*">
    <TextBlock Text="01  Develop" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="→" Margin="6,0" Foreground="#777777"/>
    <TextBlock Grid.Column="2" Text="02  Review" FontWeight="SemiBold"/><TextBlock Grid.Column="3" Text="→" Margin="6,0" Foreground="#777777"/>
    <TextBlock Grid.Column="4" Text="03  Test" FontWeight="SemiBold"/><TextBlock Grid.Column="5" Text="→" Margin="6,0" Foreground="#777777"/>
    <TextBlock Grid.Column="6" Text="04  Release" FontWeight="SemiBold"/>
   </Grid></Border>
   <ListBox Name="LiveFlow" ItemsSource="{Binding Flow}" SelectedItem="{Binding SelectedFlow, Mode=TwoWay}" ItemTemplate="{StaticResource FlowRow}" Background="Transparent" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
   <Grid ColumnDefinitions="*,Auto" Margin="0,2"><TextBlock Text="Team Performance" Classes="liveSection"/><TextBlock Grid.Column="1" Text="{Binding WindowLabel}" Classes="liveSecondary" VerticalAlignment="Center"/></Grid>
   <ItemsControl ItemsSource="{Binding Instruments}" Name="PerformanceInstruments">
    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
    <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:LiveInstrument"><Border Classes="instrument" ToolTip.Tip="{Binding Metric.Explanation}"><StackPanel Spacing="3"><TextBlock Text="{Binding Metric.Label}" Classes="metricLabel" TextWrapping="Wrap" MinHeight="30"/><TextBlock Text="{Binding Metric.Value}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Unit}" IsVisible="{Binding ShowUnit}" Classes="liveSecondary"/><charts:LivePerformanceTrendChart Series="{Binding Trend}" Unit="{Binding Unit}" Compact="True" Height="24" ToolTip.Tip="Last 20 simulated days · same performance window as the main metrics. Hover for values." AutomationProperties.Name="{Binding Metric.Label, StringFormat='Recent history: {0}'}"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate>
   </ItemsControl>

     <Border Classes="card"><StackPanel Spacing="8">
      <WrapPanel>
       <TextBlock Name="TrendHeading" Text="Performance Trend" Classes="liveSection" Margin="0,0,20,0" VerticalAlignment="Center" ToolTip.Tip="{Binding TrendDescription}"/>
       <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,12,0"><TextBlock Text="Metric" Classes="liveSecondary" VerticalAlignment="Center"/>
        <ComboBox ItemsSource="{Binding TrendMetrics}" SelectedItem="{Binding TrendMetric, Mode=TwoWay}" MinWidth="220" AutomationProperties.Name="Trend metric">
         <ComboBox.ItemTemplate><DataTemplate x:DataType="app:LiveTrendMetricOption"><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate>
        </ComboBox>
       </StackPanel>
       <StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="Range" Classes="liveSecondary" VerticalAlignment="Center"/><ComboBox ItemsSource="{Binding TrendRanges}" SelectedItem="{Binding TrendRange, Mode=TwoWay}" AutomationProperties.Name="Trend time range"/></StackPanel>
      </WrapPanel>

      <charts:LivePerformanceTrendChart Series="{Binding Trend}" Unit="{Binding TrendMetric.Unit}" SelectedDay="{Binding SelectedTrendInterventionDay}" ToolTip.Tip="Hover for day/value. Dashed lines mark interventions recorded on Day N; effects start Day N+1. Markers show timing, not causality." Height="210" AutomationProperties.Name="Performance Trend chart" />

     </StackPanel></Border>
<Expander Header="Flow details and allocations" HorizontalAlignment="Stretch"><StackPanel><TextBlock Text="{Binding QueueDetail}" TextWrapping="Wrap" Margin="8"/>     <Expander Header="Development allocations" HorizontalAlignment="Stretch">
      <StackPanel Spacing="6">
       <TextBlock Text="Most recent day: remaining effort and capacity flow. Review and Rework retain their existing allocation rules." Classes="note" />
       <ItemsControl ItemsSource="{Binding DevelopmentAllocations}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:MetricRow">
        <StackPanel Margin="4,5" ToolTip.Tip="{Binding Explanation}"><TextBlock Text="{Binding Label}" FontWeight="SemiBold"/><TextBlock Text="{Binding Value}" TextWrapping="Wrap" FontSize="12"/></StackPanel>
       </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      </StackPanel>
     </Expander>
</StackPanel></Expander>
<Expander Classes="liveAnalysis" Header="Team Performance" HorizontalAlignment="Stretch"><StackPanel Spacing="8">
     <StackPanel Orientation="Horizontal" Spacing="8">
      <TextBlock Text="Window · days" VerticalAlignment="Center"/>
      <ComboBox ItemsSource="{Binding RollingWindows}" SelectedItem="{Binding RollingWindow, Mode=TwoWay}" AutomationProperties.Name="Performance window · days" />
     </StackPanel>
     <TextBlock Text="{Binding WindowLabel}" Classes="note" />
     <TextBlock Text="DELIVERY" Classes="section" />
     <ItemsControl ItemsSource="{Binding Metrics}" ItemTemplate="{StaticResource PerformanceMetric}" />
     <Expander Header="Flow, Capacity and Quality" HorizontalAlignment="Stretch">
      <StackPanel Spacing="8">
       <TextBlock Text="FLOW" Classes="section" />
       <TextBlock Text="Now = current queue · Avg = period average · Trend = items/day" Classes="note"/>
       <ItemsControl ItemsSource="{Binding FlowMetrics}" ItemTemplate="{StaticResource PerformanceMetric}" />
       <TextBlock Text="CAPACITY" Classes="section" />
       <ItemsControl ItemsSource="{Binding CapacityMetrics}" ItemTemplate="{StaticResource PerformanceMetric}" />
       <StackPanel IsVisible="{Binding ShowPerformanceQuality}" Spacing="8">
        <TextBlock Text="QUALITY" Classes="section" />
        <ItemsControl ItemsSource="{Binding QualityMetrics}" ItemTemplate="{StaticResource PerformanceMetric}" />
       </StackPanel>
      </StackPanel>
     </Expander>
     <Border Classes="card"><StackPanel>
      <TextBlock Text="Queues over time" Classes="section" />
      <TextBlock Text="Blue: Code Review · Amber: Testing" Classes="note" />
      <TextBlock Text="Purple: Rework" Classes="note" IsVisible="{Binding ShowRework}" />
      <charts:LiveQueueChart Points="{Binding QueueHistory}" CurrentDay="{Binding Day}" Changes="{Binding Changes}" ShowRework="{Binding ShowRework}" Height="160" />
      <TextBlock Text="Point at a change marker to inspect it." Classes="note" />
     </StackPanel></Border>
</StackPanel></Expander>
     <Expander Header="Changes" IsVisible="{Binding HasChanges}" HorizontalAlignment="Stretch">
      <ListBox ItemsSource="{Binding Changes}" MaxHeight="190"><ListBox.ItemTemplate><DataTemplate x:DataType="vm:LiveChangeRow"><StackPanel Margin="4"><TextBlock Text="{Binding Day, StringFormat='Day {0}'}" FontWeight="Bold"/><TextBlock Text="{Binding Description}" TextWrapping="Wrap"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
     </Expander>
   <Expander Classes="liveAnalysis" Header="Before &amp; After an intervention" IsVisible="{Binding HasChanges}" HorizontalAlignment="Stretch">
    <StackPanel Spacing="10">
     <TextBlock Text="Uses the selected Team Performance window. A change recorded on Day N takes effect on Day N+1." Classes="note"/>
     <ComboBox ItemsSource="{Binding Interventions}" SelectedItem="{Binding SelectedIntervention, Mode=TwoWay}" HorizontalAlignment="Stretch" AutomationProperties.Name="Compare intervention">
      <ComboBox.ItemTemplate><DataTemplate x:DataType="core:ConfigurationChange"><TextBlock Text="{Binding Converter={StaticResource InterventionDescription}}" TextWrapping="Wrap"/></DataTemplate></ComboBox.ItemTemplate>
     </ComboBox>
     <TextBlock Text="{Binding BeforePeriod}"/>
     <TextBlock Text="{Binding AfterPeriod}"/>
     <TextBlock Text="{Binding ComparisonStatus}" Classes="note"/>
     <Grid ColumnDefinitions="2*,*,*,*"><TextBlock Text="METRIC"/><TextBlock Grid.Column="1" Text="BEFORE"/><TextBlock Grid.Column="2" Text="AFTER"/><TextBlock Grid.Column="3" Text="DIFFERENCE"/></Grid>
     <ItemsControl ItemsSource="{Binding ComparisonRows}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:PerformanceComparisonRow">
      <Grid ColumnDefinitions="2*,*,*,*" Margin="0,4"><TextBlock Text="{Binding Metric}" TextWrapping="Wrap" Margin="0,0,8,0"/><TextBlock Grid.Column="1" Text="{Binding Before}"/><TextBlock Grid.Column="2" Text="{Binding After}"/><TextBlock Grid.Column="3" Text="{Binding Difference}"/></Grid>
     </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     <TextBlock Text="{Binding Observations}" TextWrapping="Wrap"/>
    </StackPanel>
   </Expander>
   <Expander Header="Show details" HorizontalAlignment="Stretch"><StackPanel Spacing="8"><Button Content="Refresh all-time metrics (pauses)" Command="{Binding DetailsCommand}" HorizontalAlignment="Left"/><TextBlock Text="{Binding Details}" TextWrapping="Wrap"/></StackPanel></Expander>
   <Expander Header="Checkpoints and files" HorizontalAlignment="Stretch">
    <StackPanel Spacing="10">
     <TextBlock Text="Create or restore a checkpoint while paused. Restoring returns to its exact day and history." Classes="note" />
     <TextBox Text="{Binding CheckpointLabel, Mode=TwoWay}" Watermark="Checkpoint label" AutomationProperties.Name="Checkpoint label" MaxLength="100"/>
     <Button Content="Create Checkpoint" Command="{Binding CheckpointCommand}" HorizontalAlignment="Left" />
     <ComboBox ItemsSource="{Binding Checkpoints}" SelectedItem="{Binding SelectedCheckpoint, Mode=TwoWay}" HorizontalAlignment="Stretch"><ComboBox.ItemTemplate><DataTemplate x:DataType="vm:CheckpointRow"><TextBlock Text="{Binding Display}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
     <WrapPanel><Button Content="Restore" Command="{Binding RestoreCommand}"/><Button Content="Delete" Command="{Binding DeleteCheckpointCommand}"/><Button Content="Save Live Session" Click="SaveSession"/><Button Content="Open Live Session" Click="OpenSession"/></WrapPanel>
    </StackPanel>
   </Expander>
   <Expander Header="Advanced Live settings" HorizontalAlignment="Stretch"><StackPanel Spacing="10">
<Grid ColumnDefinitions="*,100"><TextBlock Text="Safety Limit · days" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding SafetyLimit, Mode=TwoWay}" AutomationProperties.Name="Live Safety Limit · days" /></Grid>

    <Button Content="Update safety limit" Command="{Binding LimitCommand}" HorizontalAlignment="Left" />
    <TextBlock Text="Rolling window · days"/><ComboBox ItemsSource="{Binding RollingWindows}" SelectedItem="{Binding RollingWindow, Mode=TwoWay}" />
    <WrapPanel><Button Content="Stop" Command="{Binding StopCommand}"/></WrapPanel>
    <TextBlock Text="Reset discards this timeline and its checkpoints. Save first to keep it." Classes="note"/>
   </StackPanel></Expander>
  </StackPanel>
 </StackPanel>
 </ScrollViewer>

 </Grid>
</UserControl>
