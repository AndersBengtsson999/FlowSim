<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="using:Simulation.UI.ViewModels" xmlns:charts="using:Simulation.UI.Controls"
 x:Class="Simulation.UI.Views.SensitivityView" x:DataType="vm:SensitivityViewModel">
 <ScrollViewer><StackPanel Spacing="12" Margin="0,16">
 <TextBlock Text="Sensitivity and model validation" FontSize="20" FontWeight="Bold"/>
 <TextBlock Text="One parameter changes per analysis. Triangular effort varies MostLikely while preserving bounds; invalid values are rejected. Quality parameters require a defect-enabled base. Values use a decimal point." TextWrapping="Wrap"/>
 <WrapPanel IsEnabled="{Binding CanEdit}">
<StackPanel Margin="0,0,18,12" Spacing="4"><TextBlock Text="Base Scenario"/><ComboBox MinWidth="240" ItemsSource="{Binding BaseScenarios}" SelectedItem="{Binding BaseScenario, Mode=TwoWay}" AutomationProperties.Name="Sensitivity Base Scenario"/></StackPanel>
<StackPanel Margin="0,0,18,12" Spacing="4"><TextBlock Text="Parameter"/><ComboBox MinWidth="240" ItemsSource="{Binding Parameters}" SelectedItem="{Binding Parameter, Mode=TwoWay}" AutomationProperties.Name="Sensitivity Parameter"/></StackPanel>
<StackPanel Margin="0,0,18,12" Spacing="4"><TextBlock Text="Mode"/><ComboBox MinWidth="240" ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode, Mode=TwoWay}" AutomationProperties.Name="Sensitivity Mode"/></StackPanel>
<StackPanel Margin="0,0,18,12" Spacing="4"><TextBlock Text="Values (comma separated; probabilities 0–1)"/><TextBox MinWidth="240" Text="{Binding Values, Mode=TwoWay}" AutomationProperties.Name="Sensitivity Values"/></StackPanel>
<StackPanel Margin="0,0,18,12" Spacing="4"><TextBlock Text="Monte Carlo Runs / point"/><TextBox MinWidth="240" Text="{Binding Runs, Mode=TwoWay}" AutomationProperties.Name="Sensitivity Runs"/></StackPanel>
<StackPanel Margin="0,0,18,12" Spacing="4"><TextBlock Text="Random Seed"/><TextBox MinWidth="240" Text="{Binding Seed, Mode=TwoWay}" AutomationProperties.Name="Sensitivity Seed"/></StackPanel>
<StackPanel Margin="0,0,18,12" Spacing="4"><TextBlock Text="Warm-Up Days"/><TextBox MinWidth="240" Text="{Binding WarmUpDays, Mode=TwoWay}" AutomationProperties.Name="Sensitivity WarmUpDays"/></StackPanel>
</WrapPanel>
 <WrapPanel><Button Content="Run Sensitivity Analysis" Command="{Binding RunCommand}"/><Button Content="Run Model Validation" Command="{Binding ValidateCommand}"/><Button Content="Cancel Analysis" Command="{Binding CancelCommand}" IsVisible="{Binding IsBusy}"/></WrapPanel>
 <TextBlock Text="{Binding Status}" TextWrapping="Wrap"/>
 <TextBlock Text="Measurement window excludes warm-up snapshots. Lead/cycle/active/waiting means use complete lifetimes of items finishing in the window; unfinished items are excluded. Full-run values and sample counts are in diagnostics. A warm-up does not guarantee steady state." TextWrapping="Wrap"/>
 <TextBlock Text="{Binding ResultConfiguration}" TextWrapping="Wrap"/>
 <StackPanel Orientation="Horizontal" Spacing="12"><TextBlock Text="Y metric" VerticalAlignment="Center"/><ComboBox Width="360" ItemsSource="{Binding Metrics}" SelectedItem="{Binding Metric, Mode=TwoWay}"/></StackPanel>
 <TextBlock Text="{Binding ChartLabel}" TextWrapping="Wrap"/>
 <charts:SensitivityChart Points="{Binding Points}" Metric="{Binding Metric}" Height="270"/>
 <TextBlock Text="Table: single-run values or P50; P85/P95 and deltas refer to selected Y metric. Utilization is a ratio (0–1). Delta % is undefined when the base is zero. No value is classified as good, bad or optimal." TextWrapping="Wrap"/>
 <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><StackPanel MinWidth="1920">
<Grid ColumnDefinitions="120,120,120,120,120,120,120,120,120,120,120,120,120,120,120,120" Margin="0,4"><TextBlock Grid.Column="0" Text="Value"/><TextBlock Grid.Column="1" Text="Throughput /5d"/><TextBlock Grid.Column="2" Text="Lead"/><TextBlock Grid.Column="3" Text="Cycle"/><TextBlock Grid.Column="4" Text="Waiting"/><TextBlock Grid.Column="5" Text="Avg WIP"/><TextBlock Grid.Column="6" Text="Dev util."/><TextBlock Grid.Column="7" Text="Test util."/><TextBlock Grid.Column="8" Text="Max review Q"/><TextBlock Grid.Column="9" Text="Max test Q"/><TextBlock Grid.Column="10" Text="Rework effort"/><TextBlock Grid.Column="11" Text="Selected P50"/><TextBlock Grid.Column="12" Text="Δ from base"/><TextBlock Grid.Column="13" Text="Δ %"/><TextBlock Grid.Column="14" Text="Selected P85"/><TextBlock Grid.Column="15" Text="Selected P95"/></Grid><ItemsControl ItemsSource="{Binding Rows}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:SensitivityTableRow"><Grid ColumnDefinitions="120,120,120,120,120,120,120,120,120,120,120,120,120,120,120,120" Margin="0,4"><TextBlock Grid.Column="0" Text="{Binding Value}"/><TextBlock Grid.Column="1" Text="{Binding Throughput}"/><TextBlock Grid.Column="2" Text="{Binding Lead}"/><TextBlock Grid.Column="3" Text="{Binding Cycle}"/><TextBlock Grid.Column="4" Text="{Binding Waiting}"/><TextBlock Grid.Column="5" Text="{Binding Wip}"/><TextBlock Grid.Column="6" Text="{Binding Developer}"/><TextBlock Grid.Column="7" Text="{Binding Tester}"/><TextBlock Grid.Column="8" Text="{Binding ReviewQueue}"/><TextBlock Grid.Column="9" Text="{Binding TestQueue}"/><TextBlock Grid.Column="10" Text="{Binding Rework}"/><TextBlock Grid.Column="11" Text="{Binding Selected}"/><TextBlock Grid.Column="12" Text="{Binding Delta}"/><TextBlock Grid.Column="13" Text="{Binding Percent}"/><TextBlock Grid.Column="14" Text="{Binding P85}"/><TextBlock Grid.Column="15" Text="{Binding P95}"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></ScrollViewer>
<Expander Header="Full simulation and measurement-window diagnostics (all metrics)"><TextBlock Text="{Binding Diagnostics}" FontFamily="Menlo" FontSize="12" TextWrapping="Wrap"/></Expander>
 <Expander Header="Extreme model validation report" IsExpanded="True"><TextBlock Text="{Binding ValidationReport}" FontFamily="Menlo" FontSize="12" TextWrapping="Wrap"/></Expander>
 </StackPanel></ScrollViewer>
</UserControl>
