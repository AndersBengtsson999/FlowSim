<UserControl xmlns="https://github.com/avaloniaui" xmlns:charts="using:Simulation.UI.Controls" xmlns:views="using:Simulation.UI.Views" xmlns:vm="using:Simulation.UI.ViewModels" xmlns:core="clr-namespace:Simulation.Core;assembly=Simulation.Core" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Simulation.UI.Views.AdvancedWorkspace" x:DataType="vm:MainWindowViewModel">
 <UserControl.Resources>
  <vm:PresentationLabels x:Key="HumanLabel" />
 </UserControl.Resources>
 <UserControl.Styles>
  <Style Selector="TextBlock.section">
   <Setter Property="FontSize" Value="17" />
   <Setter Property="FontWeight" Value="SemiBold" />
   <Setter Property="Foreground" Value="#173B50" />
  </Style>
  <Style Selector="TextBlock.note">
   <Setter Property="FontSize" Value="12" />
   <Setter Property="Foreground" Value="#526279" />
   <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="Border.card">
   <Setter Property="Background" Value="White" />
   <Setter Property="CornerRadius" Value="6" />
   <Setter Property="Padding" Value="18" />
  </Style>
  <Style Selector="Button">
   <Setter Property="Padding" Value="12,10" />
   <Setter Property="Margin" Value="0,0,8,5" />
  </Style>
  <Style Selector="TextBox">
   <Setter Property="MinWidth" Value="100" />
  </Style>
 </UserControl.Styles>
 <Grid RowDefinitions="Auto,*,Auto" Margin="24">
  <StackPanel Spacing="5" Margin="0,0,0,16">
   <TextBlock Text="Advanced Tools" FontSize="22" FontWeight="SemiBold" />
   <TextBlock Text="Detailed simulation analysis and model-development tools." Classes="note" />
  </StackPanel>
  <TabControl Grid.Row="1" SelectedIndex="{Binding ExpertArea, Mode=TwoWay}">
   <TabItem Header="Setup &amp; Detailed Metrics">
    <TabControl SelectedIndex="{Binding SimulatePage, Mode=TwoWay}">
     <TabItem Header="Scenario">
      <ScrollViewer>
       <StackPanel Spacing="16" Margin="0,16,0,16">
        <StackPanel IsVisible="{Binding Compare.IsEditing}" Spacing="6">
         <TextBlock Text="{Binding Compare.EditingLabel}" TextWrapping="Wrap" />
         <WrapPanel>
          <Button Content="Apply Scenario Changes" Command="{Binding Compare.ApplyCommand}" />
          <Button Content="Discard Scenario Draft" Command="{Binding Compare.DiscardCommand}" />
         </WrapPanel>
        </StackPanel>
        <Button Content="Run Baseline" Command="{Binding RunBaselineCommand}" HorizontalAlignment="Left" Background="#176A78" Foreground="White" />
        <TextBlock Text="Configure one scenario. Run the baseline, change one parameter, and run again to explore its effect." Classes="note" />
        <Grid ColumnDefinitions="*,18,*" RowDefinitions="Auto,18,Auto" IsEnabled="{Binding CanEdit}">
         <Border Grid.Column="0" Grid.Row="0" Classes="card">
          <StackPanel Spacing="10">
           <TextBlock Text="Simulation" Classes="section" />
           <Grid ColumnDefinitions="*,110">
            <StackPanel Margin="0,0,14,0">
             <TextBlock Text="Simulation Days" />
            </StackPanel>
            <TextBox Grid.Column="1" VerticalAlignment="Top" Text="{Binding DurationDays, Mode=TwoWay}" ToolTip.Tip="Number of simulated working days. Every day provides nominal capacity; calendar dates and weekends are not modelled." AutomationProperties.Name="Simulation Days" />
           </Grid>
           <Grid ColumnDefinitions="*,110">
            <StackPanel Margin="0,0,14,0">
             <TextBlock Text="Work Items" />
            </StackPanel>
            <TextBox Grid.Column="1" VerticalAlignment="Top" Text="{Binding NumberOfWorkItems, Mode=TwoWay}" ToolTip.Tip="Number of independent Work Items created at day 0. Effort is configured separately for each stage, fixed or sampled once per item." AutomationProperties.Name="Work Items" />
           </Grid>
          </StackPanel>
         </Border>
         <Border Grid.Column="2" Grid.Row="0" Classes="card">
          <StackPanel Spacing="10">
           <TextBlock Text="Team" Classes="section" />
           <Grid ColumnDefinitions="*,110">
            <StackPanel Margin="0,0,14,0">
             <TextBlock Text="Developers" />
            </StackPanel>
            <TextBox Grid.Column="1" VerticalAlignment="Top" Text="{Binding NumberOfDevelopers, Mode=TwoWay}" ToolTip.Tip="Number of developers sharing Development and Code Review work. Code Review receives capacity first." AutomationProperties.Name="Developers" />
           </Grid>
           <Grid ColumnDefinitions="*,110">
            <StackPanel Margin="0,0,14,0">
             <TextBlock Text="Testers" />
            </StackPanel>
            <TextBox Grid.Column="1" VerticalAlignment="Top" Text="{Binding NumberOfTesters, Mode=TwoWay}" ToolTip.Tip="Number of testers providing capacity for Testing only." AutomationProperties.Name="Testers" />
           </Grid>
          </StackPanel>
         </Border>
         <Border Grid.Column="0" Grid.Row="2" Classes="card">
          <StackPanel Spacing="10">
           <TextBlock Text="Flow · WIP limits" Classes="section" />
           <Grid ColumnDefinitions="*,110">
            <StackPanel Margin="0,0,14,0">
             <TextBlock Text="Development WIP" />
            </StackPanel>
            <TextBox Grid.Column="1" VerticalAlignment="Top" Text="{Binding DevelopmentWipLimit, Mode=TwoWay}" ToolTip.Tip="{x:Static vm:FlowPresentation.DevelopmentWipHelp}" AutomationProperties.Name="Development WIP" />
           </Grid>
           <Grid ColumnDefinitions="*,110">
            <StackPanel Margin="0,0,14,0">
             <TextBlock Text="Code Review WIP" />
            </StackPanel>
            <TextBox Grid.Column="1" VerticalAlignment="Top" Text="{Binding CodeReviewWipLimit, Mode=TwoWay}" ToolTip.Tip="Maximum number of Work Items actively in Code Review at once. Waiting for Code Review does not consume these slots." AutomationProperties.Name="Code Review WIP" />
           </Grid>
           <Grid ColumnDefinitions="*,110">
            <StackPanel Margin="0,0,14,0">
             <TextBlock Text="Testing WIP" />
            </StackPanel>
            <TextBox Grid.Column="1" VerticalAlignment="Top" Text="{Binding TestingWipLimit, Mode=TwoWay}" ToolTip.Tip="Maximum number of Work Items actively in Testing at once. Waiting for Testing does not consume these slots." AutomationProperties.Name="Testing WIP" />
           </Grid>
          </StackPanel>
         </Border>
         <Border Grid.Column="2" Grid.Row="2" Classes="card">
          <StackPanel Spacing="10">
           <TextBlock Text="Work · effort" Classes="section" />
           <TextBlock Text="Choose Fixed or Triangular for each stage. Effort is abstract work, not elapsed days." Classes="note" />
           <ItemsControl ItemsSource="{Binding EffortEditors}">
            <ItemsControl.ItemTemplate>
             <DataTemplate x:DataType="vm:EffortEditorViewModel">
              <StackPanel Spacing="6" Margin="0,0,0,14">
               <Grid ColumnDefinitions="*,160">
                <TextBlock Text="{Binding Stage}" FontWeight="SemiBold" VerticalAlignment="Center" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding Kinds}" SelectedItem="{Binding Kind, Mode=TwoWay}" HorizontalAlignment="Stretch" ToolTip.Tip="Fixed preserves one effort value. Triangular samples values between Minimum and Maximum, with Most Likely as the mode." AutomationProperties.Name="{Binding Stage}" />
               </Grid>
               <Grid ColumnDefinitions="*,110" IsVisible="{Binding IsFixed}">
                <TextBlock Text="Effort" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Text="{Binding FixedValue, Mode=TwoWay}" ToolTip.Tip="Capacity units needed for this stage of each Work Item; nonnegative. Not elapsed time." AutomationProperties.Name="Fixed Effort" />
               </Grid>
               <Grid ColumnDefinitions="*,8,*,8,*" IsVisible="{Binding IsTriangular}">
                <StackPanel>
                 <TextBlock Text="Minimum" />
                 <TextBox Text="{Binding Minimum, Mode=TwoWay}" ToolTip.Tip="Smallest effort, strictly greater than zero." AutomationProperties.Name="Minimum" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                 <TextBlock Text="Most Likely" />
                 <TextBox Text="{Binding MostLikely, Mode=TwoWay}" ToolTip.Tip="Mode of the triangular distribution; between Minimum and Maximum. Not necessarily the mean." AutomationProperties.Name="Most Likely" />
                </StackPanel>
                <StackPanel Grid.Column="4">
                 <TextBlock Text="Maximum" />
                 <TextBox Text="{Binding Maximum, Mode=TwoWay}" ToolTip.Tip="Largest effort; at least Most Likely." AutomationProperties.Name="Maximum" />
                </StackPanel>
               </Grid>
              </StackPanel>
             </DataTemplate>
            </ItemsControl.ItemTemplate>
           </ItemsControl>
          </StackPanel>
         </Border>
        </Grid>
        <Expander Header="Quality · defects and rework" HorizontalAlignment="Stretch">
         <StackPanel Spacing="10">
          <Border Classes="card" IsEnabled="{Binding CanEdit}">
           <StackPanel Spacing="12">
            <TextBlock Text="Quality &amp; Rework" Classes="section" />
            <CheckBox Content="Defects Enabled" IsChecked="{Binding DefectsEnabled, Mode=TwoWay}" ToolTip.Tip="Enable seeded discovery of defects after completed Code Review and Testing attempts. Disabled preserves the original forward-only flow." />
            <TextBlock Text="Defects belong to their Work Item. Review → Rework → Development share one developer pool, in that priority order. Probabilities apply to each completed inspection attempt." Classes="note" />
            <Grid ColumnDefinitions="*,24,*" IsVisible="{Binding DefectsEnabled}">
             <StackPanel Spacing="12">
              <Grid ColumnDefinitions="*,110">
               <StackPanel Margin="0,0,14,0">
                <TextBlock Text="Code Review Defect Probability (%)" TextWrapping="Wrap" />
               </StackPanel>
               <TextBox Grid.Column="1" Text="{Binding CodeReviewDefectProbability, Mode=TwoWay}" ToolTip.Tip="Probability that a completed Code Review attempt discovers a defect requiring Rework. Enter 0–100 percent." AutomationProperties.Name="Code Review Defect Probability (%)" />
              </Grid>
              <Grid ColumnDefinitions="*,110">
               <StackPanel Margin="0,0,14,0">
                <TextBlock Text="Testing Defect Probability (%)" TextWrapping="Wrap" />
               </StackPanel>
               <TextBox Grid.Column="1" Text="{Binding TestingDefectProbability, Mode=TwoWay}" ToolTip.Tip="Probability that a completed Testing attempt discovers a defect requiring Rework. Enter 0–100 percent. Corrected work must pass Code Review again." AutomationProperties.Name="Testing Defect Probability (%)" />
              </Grid>
              <Grid ColumnDefinitions="*,110">
               <StackPanel Margin="0,0,14,0">
                <TextBlock Text="Rework WIP Limit" TextWrapping="Wrap" />
               </StackPanel>
               <TextBox Grid.Column="1" Text="{Binding ReworkWipLimit, Mode=TwoWay}" ToolTip.Tip="Maximum active Rework items. Waiting for Rework does not count against this limit." AutomationProperties.Name="Rework WIP Limit" />
              </Grid>
              <TextBlock Text="A defect adds Rework effort. Rework completion always returns to Waiting for Code Review, including defects discovered in Testing. Repeated defects are possible; the simulation ends at its configured horizon." Classes="note" />
             </StackPanel>
             <StackPanel Grid.Column="2" Spacing="8">
              <TextBlock Text="Additional developer capacity required to correct a discovered defect. Sampled separately by discovery source." Classes="note" />
              <ItemsControl ItemsSource="{Binding ReworkEffortEditors}">
               <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:EffortEditorViewModel">
                 <StackPanel Spacing="6" Margin="0,0,0,14">
                  <Grid ColumnDefinitions="*,160">
                   <TextBlock Text="{Binding Stage}" FontWeight="SemiBold" VerticalAlignment="Center" />
                   <ComboBox Grid.Column="1" ItemsSource="{Binding Kinds}" SelectedItem="{Binding Kind, Mode=TwoWay}" HorizontalAlignment="Stretch" ToolTip.Tip="Fixed preserves one effort value. Triangular samples values between Minimum and Maximum, with Most Likely as the mode." AutomationProperties.Name="{Binding Stage}" />
                  </Grid>
                  <Grid ColumnDefinitions="*,110" IsVisible="{Binding IsFixed}">
                   <TextBlock Text="Effort" VerticalAlignment="Center" />
                   <TextBox Grid.Column="1" Text="{Binding FixedValue, Mode=TwoWay}" ToolTip.Tip="Capacity units needed for this stage of each Work Item; nonnegative. Not elapsed time." AutomationProperties.Name="Fixed Effort" />
                  </Grid>
                  <Grid ColumnDefinitions="*,8,*,8,*" IsVisible="{Binding IsTriangular}">
                   <StackPanel>
                    <TextBlock Text="Minimum" />
                    <TextBox Text="{Binding Minimum, Mode=TwoWay}" ToolTip.Tip="Smallest effort, strictly greater than zero." AutomationProperties.Name="Minimum" />
                   </StackPanel>
                   <StackPanel Grid.Column="2">
                    <TextBlock Text="Most Likely" />
                    <TextBox Text="{Binding MostLikely, Mode=TwoWay}" ToolTip.Tip="Mode of the triangular distribution; between Minimum and Maximum. Not necessarily the mean." AutomationProperties.Name="Most Likely" />
                   </StackPanel>
                   <StackPanel Grid.Column="4">
                    <TextBlock Text="Maximum" />
                    <TextBox Text="{Binding Maximum, Mode=TwoWay}" ToolTip.Tip="Largest effort; at least Most Likely." AutomationProperties.Name="Maximum" />
                   </StackPanel>
                  </Grid>
                 </StackPanel>
                </DataTemplate>
               </ItemsControl.ItemTemplate>
              </ItemsControl>
             </StackPanel>
            </Grid>
           </StackPanel>
          </Border>
         </StackPanel>
        </Expander>
        <Expander Header="How capacity and effort work" HorizontalAlignment="Stretch">
         <StackPanel Spacing="10">
          <Border Classes="card">
           <StackPanel Spacing="6">
            <TextBlock Text="Effort is work, not elapsed time" Classes="section" />
            <TextBlock Text="One Work Item receives at most 1 capacity unit per day, in one stage. Queues and unavailable capacity can extend elapsed time. Development, Code Review and Rework share developer capacity; Testing has a separate pool." Classes="note" />
            <TextBlock Text="This form generates independent items. Variable effort is sampled once per item and stage; daily team capacity remains fixed. Dependencies are supported by Core but are not editable here." Classes="note" />
           </StackPanel>
          </Border>
         </StackPanel>
        </Expander>
        <Expander Header="Advanced · capacity, seeds and examples" HorizontalAlignment="Stretch">
         <StackPanel Spacing="10">
          <Grid ColumnDefinitions="*,110">
           <StackPanel Margin="0,0,14,0">
            <TextBlock Text="Random Seed" />
           </StackPanel>
           <TextBox Grid.Column="1" Text="{Binding RandomSeed, Mode=TwoWay}" ToolTip.Tip="Integer seed for reproducible effort generation. The first Monte Carlo run uses this seed." AutomationProperties.Name="Random Seed" />
          </Grid>
          <Grid ColumnDefinitions="*,110">
           <StackPanel Margin="0,0,14,0">
            <TextBlock Text="Number of Runs" />
           </StackPanel>
           <TextBox Grid.Column="1" Text="{Binding NumberOfRuns, Mode=TwoWay}" ToolTip.Tip="Monte Carlo repetitions, from 1 to 10,000. Single-run mode ignores this setting." AutomationProperties.Name="Number of Runs" />
          </Grid>
          <Grid ColumnDefinitions="*,110">
           <StackPanel Margin="0,0,14,0">
            <TextBlock Text="Developer Capacity / Day" />
           </StackPanel>
           <TextBox Grid.Column="1" VerticalAlignment="Top" Text="{Binding DeveloperCapacity, Mode=TwoWay}" ToolTip.Tip="Abstract work capacity per developer and simulated day. 1.0 is one normal unit of daily capacity, not hours." AutomationProperties.Name="Developer Capacity / Day" />
          </Grid>
          <Grid ColumnDefinitions="*,110">
           <StackPanel Margin="0,0,14,0">
            <TextBlock Text="Tester Capacity / Day" />
           </StackPanel>
           <TextBox Grid.Column="1" VerticalAlignment="Top" Text="{Binding TesterCapacity, Mode=TwoWay}" ToolTip.Tip="Abstract work capacity per tester and simulated day. 1.0 is one normal unit of daily capacity, not hours." AutomationProperties.Name="Tester Capacity / Day" />
          </Grid>
          <Button Content="Run Monte Carlo" Command="{Binding MonteCarloCommand}" />
          <Button Content="Variable Effort Example" Command="{Binding VariableEffortCommand}" />
          <Button Content="Defects &amp; Rework Example" Command="{Binding DefectsExampleCommand}" />
          <Button Content="Reset to Baseline" Command="{Binding ResetCommand}" />
         </StackPanel>
        </Expander>
       </StackPanel>
      </ScrollViewer>
     </TabItem>
     <TabItem Header="Flow">
      <Grid RowDefinitions="Auto,*" Margin="0,16,0,0">
       <StackPanel Spacing="6">
        <TextBlock Text="{Binding DayLabel}" Classes="section" />
        <Grid ColumnDefinitions="Auto,*,Auto" IsEnabled="{Binding HasResults}">
         <TextBlock Text="Selected Day (1–final)" VerticalAlignment="Center" />
         <Slider Grid.Column="1" Margin="16,0" Minimum="1" Maximum="{Binding LastDay}" Value="{Binding SelectedDay, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" AutomationProperties.Name="Selected Day" />
         <TextBlock Grid.Column="2" Text="{Binding LastDay}" VerticalAlignment="Center" />
        </Grid>
        <TextBlock Text="End-of-day counts. Blue = active stage; amber = waiting queue. An active-stage item may receive no capacity. Selecting a day does not rerun the simulation." Classes="note" Margin="0,0,0,12" />
        <TextBlock Text="{Binding FlowWipLimits}" Classes="note" />
        <TextBlock Text="{Binding CapacityDetail}" Classes="note" />
        <TextBlock Text="{Binding SelectedFlowDetail}" Classes="note" />
       </StackPanel>
       <TextBlock Grid.Row="1" IsVisible="{Binding HasNoResults}" Text="Run Simulation from Scenario to see the flow and daily charts." Classes="note" />
       <Grid Grid.Row="1" ColumnDefinitions="340,18,*" IsVisible="{Binding HasResults}">
        <ScrollViewer>
         <ListBox ItemsSource="{Binding FlowStates}" SelectedItem="{Binding SelectedFlow, Mode=TwoWay}" Background="Transparent">
          <ListBox.ItemTemplate>
           <DataTemplate x:DataType="vm:FlowStateRow">
            <StackPanel>
             <Border Background="{Binding Background}" CornerRadius="5" Padding="10,5">
              <Grid ColumnDefinitions="*,Auto">
               <StackPanel>
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Kind}" Classes="note" />
               </StackPanel>
               <StackPanel Grid.Column="1" Margin="8,0,0,0">
                <TextBlock Text="{Binding Count}" FontSize="20" HorizontalAlignment="Right" />
                <TextBlock Text="Work Items" FontSize="10" />
               </StackPanel>
              </Grid>
             </Border>
             <ProgressBar Value="{Binding Count}" Maximum="100" Height="5" Foreground="#BD8A36" />
             <TextBlock Text="{Binding Arrow}" HorizontalAlignment="Center" Foreground="#64748B" FontSize="12" />
            </StackPanel>
           </DataTemplate>
          </ListBox.ItemTemplate>
         </ListBox>
        </ScrollViewer>
        <ScrollViewer Grid.Column="2">
         <StackPanel Spacing="12">
          <Expander Header="Work Item details · select an item" HorizontalAlignment="Stretch">
           <StackPanel Spacing="10">
            <Grid RowDefinitions="Auto,Auto,*" Margin="0,12" Height="400">
             <ComboBox ItemsSource="{Binding WorkItems}" SelectedItem="{Binding SelectedWorkItem, Mode=TwoWay}" Width="300" HorizontalAlignment="Left" AutomationProperties.Name="History Work Item">
              <ComboBox.ItemTemplate>
               <DataTemplate x:DataType="core:WorkItemResult">
                <TextBlock Text="{Binding Id}" />
               </DataTemplate>
              </ComboBox.ItemTemplate>
             </ComboBox>
             <TextBlock Grid.Row="1" Text="Boundary days are zero-based. Capacity is applied during [day, day+1); completion and defect discovery are stamped day+1. Repeated inspections and rework are retained." Classes="note" Margin="0,10" />
             <ScrollViewer Grid.Row="2">
              <ItemsControl ItemsSource="{Binding SelectedHistory}">
               <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:HistoryRow">
                 <Border Background="White" Padding="10" Margin="0,0,0,3">
                  <Grid ColumnDefinitions="70,*">
                   <TextBlock Text="{Binding Day, StringFormat='Day {0}'}" />
                   <TextBlock Grid.Column="1" Text="{Binding Description}" TextWrapping="Wrap" />
                  </Grid>
                 </Border>
                </DataTemplate>
               </ItemsControl.ItemTemplate>
              </ItemsControl>
             </ScrollViewer>
            </Grid>
           </StackPanel>
          </Expander>
          <Expander Header="Daily charts and feedback details" HorizontalAlignment="Stretch">
           <StackPanel Spacing="10">
            <Border Classes="card">
             <StackPanel Spacing="8">
              <TextBlock Text="Feedback loop · Code Review or Testing discovers a defect ↘" Classes="section" TextWrapping="Wrap" />
              <Grid ColumnDefinitions="*,30,*">
               <Border Background="#FFF2D8" Padding="12">
                <StackPanel>
                 <TextBlock Text="Waiting for Rework" FontWeight="SemiBold" />
                 <TextBlock Text="{Binding WaitingForReworkCount}" FontSize="22" />
                 <TextBlock Text="Work Items · queue" Classes="note" />
                </StackPanel>
               </Border>
               <TextBlock Grid.Column="1" Text="→" VerticalAlignment="Center" HorizontalAlignment="Center" />
               <Border Grid.Column="2" Background="#E8F1F7" Padding="12">
                <StackPanel>
                 <TextBlock Text="Rework" FontWeight="SemiBold" />
                 <TextBlock Text="{Binding ReworkCount}" FontSize="22" />
                 <TextBlock Text="Work Items · developer capacity" Classes="note" />
                </StackPanel>
               </Border>
              </Grid>
              <TextBlock Text="↩ Rework completed → Waiting for Code Review. The main downward flow shows successful inspections; Testing defects also return through Code Review before Testing again." Classes="note" />
             </StackPanel>
            </Border>
            <Border Classes="card">
             <StackPanel>
              <TextBlock Text="WIP over time" Classes="section" />
              <TextBlock Text="Total WIP · all started but unfinished Work Items, including queues" Classes="note" />
              <charts:DailyChart Days="{Binding Days}" SelectedDay="{Binding SelectedDay}" Mode="Wip" Height="190" />
             </StackPanel>
            </Border>
            <Border Classes="card">
             <StackPanel>
              <TextBlock Text="Queues over time" Classes="section" />
              <TextBlock Text="Blue: Waiting for Code Review · Amber: Waiting for Testing" Classes="note" />
              <charts:DailyChart Days="{Binding Days}" SelectedDay="{Binding SelectedDay}" Mode="Queues" Height="190" />
             </StackPanel>
            </Border>
            <Border Classes="card">
             <StackPanel>
              <TextBlock Text="Rework over time" Classes="section" />
              <TextBlock Text="Blue: active Rework · Amber: Waiting for Rework" Classes="note" />
              <charts:DailyChart Days="{Binding Days}" SelectedDay="{Binding SelectedDay}" Mode="ReworkStates" Height="170" />
             </StackPanel>
            </Border>
            <Border Classes="card">
             <StackPanel>
              <TextBlock Text="Daily capacity" Classes="section" />
              <TextBlock Text="Blue: used · Gray: available · abstract capacity units" Classes="note" />
              <TextBlock Text="{Binding CapacityDetail}" Classes="note" Margin="0,6" />
              <TextBlock Text="Developers · Development + Code Review + Rework" FontWeight="SemiBold" />
              <charts:DailyChart Days="{Binding Days}" SelectedDay="{Binding SelectedDay}" Mode="Developers" Height="170" />
              <TextBlock Text="Rework · part of used developer capacity" FontWeight="SemiBold" />
              <charts:DailyChart Days="{Binding Days}" SelectedDay="{Binding SelectedDay}" Mode="ReworkCapacity" Height="170" />
              <TextBlock Text="Testers · Testing" FontWeight="SemiBold" />
              <charts:DailyChart Days="{Binding Days}" SelectedDay="{Binding SelectedDay}" Mode="Testers" Height="170" />
             </StackPanel>
            </Border>
           </StackPanel>
          </Expander>
         </StackPanel>
        </ScrollViewer>
       </Grid>
      </Grid>
     </TabItem>
     <TabItem Header="Results">
      <Grid Margin="0,16,0,0">
       <TextBlock IsVisible="{Binding HasNoResults}" Text="Run Simulation to see metrics and Work Item details." Classes="note" />
       <TabControl IsVisible="{Binding HasResults}">
        <TabItem Header="Summary">
         <ScrollViewer>
          <StackPanel Spacing="12" Margin="0,12">
           <TextBlock Text="{Binding SingleRunLabel}" Classes="section" />
           <TextBlock Text="Results from the last completed run. Time averages include completed Work Items only; an empty average is shown as 0." Classes="note" />
           <ItemsControl ItemsSource="{Binding PrimaryMetrics}">
            <ItemsControl.ItemTemplate>
             <DataTemplate x:DataType="vm:MetricRow">
              <Border Padding="14,10" Margin="0,0,0,6" ToolTip.Tip="{Binding Explanation}">
               <Grid ColumnDefinitions="*,210">
                <StackPanel Margin="0,0,16,0">
                 <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding Value}" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="17" />
               </Grid>
              </Border>
             </DataTemplate>
            </ItemsControl.ItemTemplate>
           </ItemsControl>
           <TextBlock Text="Largest observed queue" FontWeight="SemiBold" />
           <TextBlock Text="{Binding LargestQueue}" />
           <WrapPanel>
            <Button Content="View Flow" Command="{Binding ViewFlowCommand}" />
            <Button Content="Duplicate &amp; Compare" Command="{Binding DuplicateCompareCommand}" />
           </WrapPanel>
           <Expander Header="Advanced Results" HorizontalAlignment="Stretch">
            <StackPanel Spacing="10">
             <ItemsControl ItemsSource="{Binding AdvancedMetrics}">
              <ItemsControl.ItemTemplate>
               <DataTemplate x:DataType="vm:MetricRow">
                <Border Classes="card" Padding="14,10" Margin="0,0,0,6" ToolTip.Tip="{Binding Explanation}">
                 <Grid ColumnDefinitions="*,210">
                  <StackPanel Margin="0,0,16,0">
                   <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                   <TextBlock Text="{Binding Explanation}" Classes="note" />
                  </StackPanel>
                  <TextBlock Grid.Column="1" Text="{Binding Value}" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="17" />
                 </Grid>
                </Border>
               </DataTemplate>
              </ItemsControl.ItemTemplate>
             </ItemsControl>
             <TextBlock Text="Quality &amp; Rework" Classes="section" />
             <ItemsControl ItemsSource="{Binding QualityMetrics}">
              <ItemsControl.ItemTemplate>
               <DataTemplate x:DataType="vm:MetricRow">
                <Border Classes="card" Padding="14,10" Margin="0,0,0,6" ToolTip.Tip="{Binding Explanation}">
                 <Grid ColumnDefinitions="*,210">
                  <StackPanel Margin="0,0,16,0">
                   <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                   <TextBlock Text="{Binding Explanation}" Classes="note" />
                  </StackPanel>
                  <TextBlock Grid.Column="1" Text="{Binding Value}" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="17" />
                 </Grid>
                </Border>
               </DataTemplate>
              </ItemsControl.ItemTemplate>
             </ItemsControl>
             <TextBlock Text="High utilization is not automatically good. High WIP is not automatically bad. These metrics describe system behaviour and should be interpreted together." Classes="note" />
             <TextBlock Text="Active time + queue waiting need not equal cycle time: admitted items can stall without capacity. An end-of-day queue count can be nonzero even when admission at the next boundary gives zero elapsed queue waiting." Classes="note" />
             <ItemsControl ItemsSource="{Binding CapacityMetrics}">
              <ItemsControl.ItemTemplate>
               <DataTemplate x:DataType="vm:MetricRow">
                <Border Classes="card" Padding="14,10" Margin="0,0,0,6" ToolTip.Tip="{Binding Explanation}">
                 <Grid ColumnDefinitions="*,210">
                  <StackPanel Margin="0,0,16,0">
                   <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                   <TextBlock Text="{Binding Explanation}" Classes="note" />
                  </StackPanel>
                  <TextBlock Grid.Column="1" Text="{Binding Value}" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="17" />
                 </Grid>
                </Border>
               </DataTemplate>
              </ItemsControl.ItemTemplate>
             </ItemsControl>
            </StackPanel>
           </Expander>
          </StackPanel>
         </ScrollViewer>
        </TabItem>
        <TabItem Header="Work Items">
         <Grid RowDefinitions="Auto,*" Margin="0,12">
          <TextBlock Text="Read-only results, in scenario order. Days are boundary timestamps: start 0, finish up to the horizon. Blank lead/cycle time means incomplete. Times are simulated working days." Classes="note" Margin="0,0,0,12" />
          <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
           <StackPanel MinWidth="2220">
            <Grid ColumnDefinitions="110,100,190,120,80,100,100,100,110,100,140,140,140,110,110,150,150,150" Background="#E2E8F0" Margin="0,0,0,4">
             <TextBlock Grid.Column="0" Text="Id" Margin="8" TextWrapping="Wrap" FontWeight="SemiBold" />
             <TextBlock Grid.Column="1" Text="Name" Margin="8" TextWrapping="Wrap" FontWeight="SemiBold" />
             <TextBlock Grid.Column="2" Text="Final State" Margin="8" TextWrapping="Wrap" FontWeight="SemiBold" />
             <TextBlock Grid.Column="3" Text="Development Started" Margin="8" TextWrapping="Wrap" FontWeight="SemiBold" />
             <TextBlock Grid.Column="4" Text="Done" Margin="8" TextWrapping="Wrap" FontWeight="SemiBold" />
             <TextBlock Grid.Column="5" Text="Lead Time" Margin="8" TextWrapping="Wrap" FontWeight="SemiBold" />
             <TextBlock Grid.Column="6" Text="Cycle Time" Margin="8" TextWrapping="Wrap" FontWeight="SemiBold" />
             <TextBlock Grid.Column="7" Text="Active Time" Margin="8" TextWrapping="Wrap" FontWeight="SemiBold" />
             <TextBlock Grid.Column="8" Text="Waiting Time" Margin="8" TextWrapping="Wrap" FontWeight="SemiBold" />
             <TextBlock Grid.Column="9" Text="Blocked Time" Margin="8" TextWrapping="Wrap" FontWeight="SemiBold" />
             <TextBlock Grid.Column="10" Text="Development Effort" Margin="8" TextWrapping="Wrap" FontWeight="SemiBold" />
             <TextBlock Grid.Column="11" Text="Code Review Effort" Margin="8" TextWrapping="Wrap" FontWeight="SemiBold" />
             <TextBlock Grid.Column="12" Text="Testing Effort" Margin="8" TextWrapping="Wrap" FontWeight="SemiBold" />
             <TextBlock Grid.Column="13" Text="Defects Found" Margin="8" TextWrapping="Wrap" FontWeight="SemiBold" />
             <TextBlock Grid.Column="14" Text="Rework Count" Margin="8" TextWrapping="Wrap" FontWeight="SemiBold" />
             <TextBlock Grid.Column="15" Text="Total Rework Effort" Margin="8" TextWrapping="Wrap" FontWeight="SemiBold" />
             <TextBlock Grid.Column="16" Text="Code Review Attempts" Margin="8" TextWrapping="Wrap" FontWeight="SemiBold" />
             <TextBlock Grid.Column="17" Text="Testing Attempts" Margin="8" TextWrapping="Wrap" FontWeight="SemiBold" />
            </Grid>
            <ItemsControl ItemsSource="{Binding WorkItems}">
             <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="core:WorkItemResult">
               <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="110,100,190,120,80,100,100,100,110,100,140,140,140,110,110,150,150,150">
                 <TextBlock Grid.Column="0" Text="{Binding Id}" Margin="8" />
                 <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="8" />
                 <TextBlock Grid.Column="2" Text="{Binding FinalState, Converter={StaticResource HumanLabel}}" Margin="8" />
                 <TextBlock Grid.Column="3" Text="{Binding DevelopmentStartedDay}" Margin="8" />
                 <TextBlock Grid.Column="4" Text="{Binding DoneDay}" Margin="8" />
                 <TextBlock Grid.Column="5" Text="{Binding LeadTime}" Margin="8" />
                 <TextBlock Grid.Column="6" Text="{Binding CycleTime}" Margin="8" />
                 <TextBlock Grid.Column="7" Text="{Binding ActiveTime}" Margin="8" />
                 <TextBlock Grid.Column="8" Text="{Binding WaitingTime}" Margin="8" />
                 <TextBlock Grid.Column="9" Text="{Binding BlockedTime}" Margin="8" />
                 <TextBlock Grid.Column="10" Text="{Binding DevelopmentEffort, StringFormat=0.###}" Margin="8" ToolTip.Tip="{Binding DevelopmentEffort}" />
                 <TextBlock Grid.Column="11" Text="{Binding CodeReviewEffort, StringFormat=0.###}" Margin="8" ToolTip.Tip="{Binding CodeReviewEffort}" />
                 <TextBlock Grid.Column="12" Text="{Binding TestingEffort, StringFormat=0.###}" Margin="8" ToolTip.Tip="{Binding TestingEffort}" />
                 <TextBlock Grid.Column="13" Text="{Binding DefectsFound, StringFormat=0.###}" Margin="8" ToolTip.Tip="{Binding DefectsFound}" />
                 <TextBlock Grid.Column="14" Text="{Binding ReworkCount, StringFormat=0.###}" Margin="8" ToolTip.Tip="{Binding ReworkCount}" />
                 <TextBlock Grid.Column="15" Text="{Binding TotalReworkEffort, StringFormat=0.###}" Margin="8" ToolTip.Tip="{Binding TotalReworkEffort}" />
                 <TextBlock Grid.Column="16" Text="{Binding CodeReviewAttempts, StringFormat=0.###}" Margin="8" ToolTip.Tip="{Binding CodeReviewAttempts}" />
                 <TextBlock Grid.Column="17" Text="{Binding TestingAttempts, StringFormat=0.###}" Margin="8" ToolTip.Tip="{Binding TestingAttempts}" />
                </Grid>
               </Border>
              </DataTemplate>
             </ItemsControl.ItemTemplate>
            </ItemsControl>
           </StackPanel>
          </ScrollViewer>
         </Grid>
        </TabItem>
        <TabItem Header="Item History">
         <Grid RowDefinitions="Auto,Auto,*" Margin="0,12">
          <ComboBox ItemsSource="{Binding WorkItems}" SelectedItem="{Binding SelectedWorkItem, Mode=TwoWay}" Width="300" HorizontalAlignment="Left" AutomationProperties.Name="History Work Item">
           <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="core:WorkItemResult">
             <TextBlock Text="{Binding Id}" />
            </DataTemplate>
           </ComboBox.ItemTemplate>
          </ComboBox>
          <TextBlock Grid.Row="1" Text="Boundary days are zero-based. Capacity is applied during [day, day+1); completion and defect discovery are stamped day+1. Repeated inspections and rework are retained." Classes="note" Margin="0,10" />
          <ScrollViewer Grid.Row="2">
           <ItemsControl ItemsSource="{Binding SelectedHistory}">
            <ItemsControl.ItemTemplate>
             <DataTemplate x:DataType="vm:HistoryRow">
              <Border Background="White" Padding="10" Margin="0,0,0,3">
               <Grid ColumnDefinitions="70,*">
                <TextBlock Text="{Binding Day, StringFormat='Day {0}'}" />
                <TextBlock Grid.Column="1" Text="{Binding Description}" TextWrapping="Wrap" />
               </Grid>
              </Border>
             </DataTemplate>
            </ItemsControl.ItemTemplate>
           </ItemsControl>
          </ScrollViewer>
         </Grid>
        </TabItem>
       </TabControl>
      </Grid>
     </TabItem>
    </TabControl>
   </TabItem>
   <TabItem Header="Diagnostics &amp; uncertainty">
    <TabControl SelectedIndex="{Binding AnalyzePage, Mode=TwoWay}">
     <TabItem Header="Sensitivity">
      <views:SensitivityView DataContext="{Binding Sensitivity}" />
     </TabItem>
     <TabItem Header="Model Validation">
      <StackPanel DataContext="{Binding Sensitivity}" Spacing="12" Margin="0,20" x:DataType="vm:SensitivityViewModel">
       <TextBlock Text="For model builders" FontSize="20" />
       <TextBlock Text="Model Validation verifies that the simulation responds logically to extreme parameter changes." TextWrapping="Wrap" />
       <Button Content="Run Model Validation" Command="{Binding ValidateCommand}" HorizontalAlignment="Left" />
       <Button Content="Cancel Analysis" Command="{Binding CancelCommand}" IsVisible="{Binding IsBusy}" HorizontalAlignment="Left" />
       <TextBlock Text="{Binding Status}" />
       <ScrollViewer MaxHeight="500">
        <TextBlock Text="{Binding DisplayValidationReport}" TextWrapping="Wrap" />
       </ScrollViewer>
      </StackPanel>
     </TabItem>
     <TabItem Header="Monte Carlo">
      <ScrollViewer>
       <StackPanel Spacing="14" Margin="0,16">
        <Button Content="Run Monte Carlo" Command="{Binding MonteCarloCommand}" HorizontalAlignment="Left" />
        <TextBlock Text="Uses the Scenario form and Advanced settings. P50: median. P85/P95: 85%/95% of runs at or below this value." TextWrapping="Wrap" />
        <TextBlock Text="{Binding MonteCarloLabel}" Classes="section" />
        <TextBlock Text="Repeated runs sample effort and, when enabled, defect discovery and Rework. Capacity stays fixed. These are model outcomes, not real-project predictions without calibration. The Variable Effort Example is illustrative, not Easy-Laser data." Classes="note" />
        <StackPanel IsVisible="{Binding HasMonteCarlo}" Spacing="14">
         <TextBlock Text="Percentiles of per-run metrics · linear interpolation · Samples = runs included. Lead/cycle percentiles omit runs with no completed items. Other metrics include every run. — means no observations." Classes="note" />
         <Grid ColumnDefinitions="*,100,100,100,100,80" Background="#E2E8F0">
          <TextBlock Text="Metric" Margin="10" />
          <TextBlock Grid.Column="1" Text="P50" Margin="10" />
          <TextBlock Grid.Column="2" Text="P75" Margin="10" />
          <TextBlock Grid.Column="3" Text="P85" Margin="10" />
          <TextBlock Grid.Column="4" Text="P95" Margin="10" />
          <TextBlock Grid.Column="5" Text="Samples" Margin="10" />
         </Grid>
         <ItemsControl ItemsSource="{Binding MonteCarloMetrics}">
          <ItemsControl.ItemTemplate>
           <DataTemplate x:DataType="vm:PercentileRow">
            <Border Background="White" Padding="0,6" Margin="0,0,0,3">
             <Grid ColumnDefinitions="*,100,100,100,100,80">
              <TextBlock Text="{Binding Name}" Margin="10,0" TextWrapping="Wrap" />
              <TextBlock Grid.Column="1" Text="{Binding P50}" Margin="10,0" />
              <TextBlock Grid.Column="2" Text="{Binding P75}" Margin="10,0" />
              <TextBlock Grid.Column="3" Text="{Binding P85}" Margin="10,0" />
              <TextBlock Grid.Column="4" Text="{Binding P95}" Margin="10,0" />
              <TextBlock Grid.Column="5" Text="{Binding SampleCount}" Margin="10,0" />
             </Grid>
            </Border>
           </DataTemplate>
          </ItemsControl.ItemTemplate>
         </ItemsControl>
         <TextBlock Text="Quality &amp; Rework · all runs included" Classes="section" />
         <ItemsControl ItemsSource="{Binding MonteCarloQualityMetrics}">
          <ItemsControl.ItemTemplate>
           <DataTemplate x:DataType="vm:PercentileRow">
            <Border Background="White" Padding="0,6" Margin="0,0,0,3">
             <Grid ColumnDefinitions="*,100,100,100,100,80">
              <TextBlock Text="{Binding Name}" Margin="10,0" TextWrapping="Wrap" />
              <TextBlock Grid.Column="1" Text="{Binding P50}" Margin="10,0" />
              <TextBlock Grid.Column="2" Text="{Binding P75}" Margin="10,0" />
              <TextBlock Grid.Column="3" Text="{Binding P85}" Margin="10,0" />
              <TextBlock Grid.Column="4" Text="{Binding P95}" Margin="10,0" />
              <TextBlock Grid.Column="5" Text="{Binding SampleCount}" Margin="10,0" />
             </Grid>
            </Border>
           </DataTemplate>
          </ItemsControl.ItemTemplate>
         </ItemsControl>
         <Grid ColumnDefinitions="*,16,*">
          <Border Classes="card">
           <StackPanel>
            <TextBlock Text="Average Lead Time" Classes="section" />
            <charts:HistogramChart Bins="{Binding LeadTimeHistogram}" AxisLabel="Average Lead Time (working days)" Height="240" />
           </StackPanel>
          </Border>
          <Border Grid.Column="2" Classes="card">
           <StackPanel>
            <TextBlock Text="Throughput / 5 days" Classes="section" />
            <charts:HistogramChart Bins="{Binding ThroughputHistogram}" AxisLabel="Work Items / 5 working days" Height="240" />
           </StackPanel>
          </Border>
         </Grid>
         <TextBlock Text="Histograms use 10 equal-width bins; identical observations share one bar. Queue percentiles refer to each run's maximum end-of-day queue. A higher percentile is not automatically better or worse." Classes="note" />
         <TextBlock Text="Flow and Results retain the last single run, not an averaged Monte Carlo run. Select Run Simulation to inspect individual generated efforts and daily flow at the current seed." Classes="note" />
        </StackPanel>
       </StackPanel>
      </ScrollViewer>
     </TabItem>
    </TabControl>
   </TabItem>
  </TabControl>
  <StackPanel Grid.Row="2" Spacing="8" Margin="0,16,0,0" IsVisible="{Binding ShowSimulationActions}">
   <WrapPanel Orientation="Horizontal">
    <Button Content="Run Simulation" Command="{Binding RunCommand}" Background="#176A78" Foreground="White" />
    <Button Content="Cancel" Command="{Binding CancelCommand}" IsVisible="{Binding IsBusy}" />
   </WrapPanel>
   <TextBlock Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" Foreground="#B42318" TextWrapping="Wrap" />
   <TextBlock Text="{Binding StatusMessage}" Classes="note" />
  </StackPanel>
 </Grid>
</UserControl>
