<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:app="using:Simulation.Application" xmlns:vm="using:Simulation.UI.ViewModels" xmlns:charts="using:Simulation.UI.Controls" x:Class="Simulation.UI.Views.KpiDashboardView" x:DataType="vm:LiveViewModel" Name="Dashboard" Foreground="{DynamicResource FlowText}">
 <UserControl.Styles><Style Selector="Button"><Setter Property="MinHeight" Value="30"/><Setter Property="Padding" Value="10,5"/><Setter Property="Margin" Value="0"/></Style><Style Selector="Button.compactKpi:pointerover"><Setter Property="Opacity" Value="0.82"/></Style><Style Selector="Button:focus-visible"><Setter Property="BorderBrush" Value="{DynamicResource FlowAccent}"/><Setter Property="BorderThickness" Value="2"/></Style></UserControl.Styles>
 <Border Background="{DynamicResource FlowPanel}" CornerRadius="6" Padding="5">
  <StackPanel Spacing="4">
   <Grid Name="DashboardHeading" ColumnDefinitions="*,Auto,Auto">
    <Button Name="AnalyzeKpis" Grid.Column="1" Content="Analyze ↗" Click="ExpandExplorerClicked" Margin="0,0,6,0" AutomationProperties.Name="Open detailed KPI analysis"/>
    <TextBlock Name="DashboardTitle" Text="Team Performance" FontWeight="Bold" Foreground="{DynamicResource FlowText}" VerticalAlignment="Center"/>
    <Button Grid.Column="2" Name="ChooseKpis" Content="KPIs…" Padding="6,3" AutomationProperties.Name="Choose up to four KPIs">
     <Button.Flyout><Flyout><StackPanel Spacing="4" Width="290">
      <TextBlock Text="Choose up to four KPIs" FontWeight="Bold"/>
      <TextBlock Text="{Binding KpiSelectionSummary}" TextWrapping="Wrap"/>
      <ScrollViewer MaxHeight="360"><ItemsControl ItemsSource="{Binding KpiChoices}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:KpiChoice">
       <CheckBox Content="{Binding Name}" IsChecked="{Binding Selected, Mode=TwoWay}" IsEnabled="{Binding CanSelect}" ToolTip.Tip="{Binding Help}" AutomationProperties.Name="{Binding Name}"/>
      </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
      <TextBlock Text="Saved with the LIVE session. Changes are neutral; higher is not always better." TextWrapping="Wrap" FontSize="12"/>
     </StackPanel></Flyout></Button.Flyout>
    </Button>
   </Grid>
   <StackPanel Name="EvaluationHeading" Orientation="Horizontal" Spacing="6"><TextBlock Text="Rolling evaluation · days" Foreground="{DynamicResource FlowText}" VerticalAlignment="Center"/><ComboBox Name="KpiWindowPicker" ItemsSource="{Binding KpiWindows}" SelectedItem="{Binding KpiWindow}" MinHeight="24" Padding="6,2" AutomationProperties.Name="KPI rolling evaluation days"/></StackPanel>
   <TextBlock Text="Choose KPIs to show values." IsVisible="{Binding NoKpis}" Foreground="{DynamicResource FlowText}"/>
   <WrapPanel IsVisible="False">
    <Button Name="ExpandExplorer" Background="{DynamicResource FlowAccent}" Foreground="{DynamicResource FlowOnAccent}" FontWeight="SemiBold" Content="Expand Explorer ↗" Click="ExpandExplorerClicked" ToolTip.Tip="Open a larger, non-modal Explorer. The workshop stays active."/>
    <Button Name="DetachedNote" Content="Explorer is open ↗" Click="ExpandExplorerClicked"/>
   </WrapPanel>
   <Border Name="ExplorerSurface" Background="{DynamicResource FlowPanel}" CornerRadius="4" Padding="8">
     <ScrollViewer Name="ExplorerScroll" MaxHeight="620" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="6">
       <Grid ColumnDefinitions="*,Auto"><TextBlock Text="KPI Explorer" FontWeight="Bold"/><Button Name="CloseExplorerButton" Grid.Column="1" Content="Compact view" Click="CloseExplorerClicked"/></Grid>
       <ComboBox Name="ExplorerModePicker" ItemsSource="{Binding ExplorerModes}" SelectedItem="{Binding ExplorerMode}" HorizontalAlignment="Stretch" AutomationProperties.Name="Explorer comparison mode"/>
       <StackPanel IsVisible="{Binding ExploreMetrics}" Spacing="10">
       <Grid Name="MetricSelectors" ColumnDefinitions="*" RowDefinitions="Auto,Auto">
        <StackPanel Spacing="4">
         <TextBlock Text="Primary KPI"/>
         <ComboBox ItemsSource="{Binding ExplorerOptions}" SelectedItem="{Binding PrimaryKpi}" HorizontalAlignment="Stretch" AutomationProperties.Name="Primary KPI"><ComboBox.ItemTemplate><DataTemplate x:DataType="app:TeamKpiDefinition"><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
        </StackPanel>
        <StackPanel Name="ComparisonSelector" Grid.Row="1" IsVisible="{Binding CompareKpis}" Spacing="4">
         <TextBlock Text="Comparison KPI"/>
         <ComboBox ItemsSource="{Binding ExplorerOptions}" SelectedItem="{Binding ComparisonKpi}" HorizontalAlignment="Stretch" AutomationProperties.Name="Comparison KPI"><ComboBox.ItemTemplate><DataTemplate x:DataType="app:TeamKpiDefinition"><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
        </StackPanel>
       </Grid>
       <StackPanel IsVisible="{Binding CompareKpis}" Spacing="6">
        <Button Content="Remove comparison" Click="RemoveComparisonClicked" IsVisible="{Binding HasComparison}" HorizontalAlignment="Left"/>
        <TextBlock Text="Choose a second KPI to compare its development with the primary KPI." IsVisible="{Binding ComparisonEmpty}" TextWrapping="Wrap"/>
        <TextBlock Text="Separate value scales · units and dates shown on each chart. Association does not establish causation." TextWrapping="Wrap" FontSize="12"/>
       </StackPanel>
       <Grid Name="MetricGraphs" RowDefinitions="Auto,Auto" ColumnDefinitions="*">
       <ContentControl Name="PrimaryMetric" Content="{Binding ExplorerPrimary}"><ContentControl.ContentTemplate><DataTemplate x:DataType="vm:KpiCard"><StackPanel Spacing="8">
        <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{DynamicResource FlowAccent}"/>
        <WrapPanel><TextBlock Text="{Binding Value}" FontSize="32" FontWeight="Bold" Margin="0,0,8,0"/><TextBlock Text="{Binding Unit}" VerticalAlignment="Center"/></WrapPanel>
        <TextBlock Text="{Binding ValuePeriod}" FontSize="12"/>
        <TextBlock Text="{Binding ShortDefinition}" TextWrapping="Wrap"/>
        <TextBlock Text="{Binding FinancialQualification}" IsVisible="{Binding IsBalance}" TextWrapping="Wrap" FontSize="12"/>
        <TextBlock Text="{Binding WindowExplanation}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource FlowSecondary}"/>
        <UniformGrid Columns="3" IsVisible="{Binding IsBalance}">
         <StackPanel Margin="0,4,8,4"><TextBlock Text="Work in progress" TextWrapping="Wrap" FontSize="12"/><TextBlock Text="{Binding WipBalance}" FontWeight="SemiBold" TextWrapping="Wrap"/></StackPanel>
         <StackPanel Margin="0,4,8,4"><TextBlock Text="Awaiting launch" TextWrapping="Wrap" FontSize="12"/><TextBlock Text="{Binding AwaitingBalance}" FontWeight="SemiBold" TextWrapping="Wrap"/></StackPanel>
         <StackPanel Margin="0,4,0,4"><TextBlock Text="Unlaunched total" TextWrapping="Wrap" FontSize="12"/><TextBlock Text="{Binding TotalBalance}" FontWeight="SemiBold" TextWrapping="Wrap"/></StackPanel>
        </UniformGrid>
        <TextBlock Text="{Binding HistoryCaption}" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <charts:LivePerformanceTrendChart IsVisible="{Binding IsPeriod}" Series="{Binding Trend}" Unit="{Binding Unit}" NumberFormat="{Binding NumberFormat}" SeriesBrush="{DynamicResource FlowAccent}" SamplesOnly="True" Height="{Binding #Dashboard.ChartHeight}"/>
        <StackPanel IsVisible="{Binding IsBalance}" Spacing="3">
         <WrapPanel><TextBlock Text="● WIP   " Foreground="{DynamicResource FlowAccent}"/><TextBlock Text="● Awaiting launch   " Foreground="{DynamicResource FlowWarning}"/><TextBlock Text="● Unlaunched total" Foreground="{DynamicResource FlowPurple}"/></WrapPanel>
         <charts:LaunchCostChart History="{Binding ExplorerBalanceHistory}" UnlaunchedOnly="True" Height="{Binding #Dashboard.ChartHeight}"/>
        </StackPanel>
        <Expander Header="How it's calculated" HorizontalAlignment="Stretch"><StackPanel Spacing="6">
         <TextBlock Text="{Binding ExplorerDescription}" TextWrapping="Wrap"/>
         <TextBlock Text="{Binding Kind}" TextWrapping="Wrap"/>
         <TextBlock Text="{Binding Change}" TextWrapping="Wrap"/>
         <Button Content="Open KPI guide" Click="OpenMetricGuide" HorizontalAlignment="Left"/>
        </StackPanel></Expander>
        <Expander Header="Data limitations" HorizontalAlignment="Stretch"><TextBlock Text="{Binding Limitations}" TextWrapping="Wrap"/></Expander>
       </StackPanel></DataTemplate></ContentControl.ContentTemplate></ContentControl>
       <ContentControl Name="SecondaryMetric" Content="{Binding ExplorerSecondary}" Grid.Row="1" IsVisible="{Binding ShowKpiComparison}"><ContentControl.ContentTemplate><DataTemplate x:DataType="vm:KpiCard"><StackPanel Spacing="8">
        <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{DynamicResource FlowPurple}"/>
        <WrapPanel><TextBlock Text="{Binding Value}" FontSize="32" FontWeight="Bold" Margin="0,0,8,0"/><TextBlock Text="{Binding Unit}" VerticalAlignment="Center"/></WrapPanel>
        <TextBlock Text="{Binding ValuePeriod}" FontSize="12"/>
        <TextBlock Text="{Binding ShortDefinition}" TextWrapping="Wrap"/>
        <TextBlock Text="{Binding FinancialQualification}" IsVisible="{Binding IsBalance}" TextWrapping="Wrap" FontSize="12"/>
        <TextBlock Text="{Binding WindowExplanation}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource FlowSecondary}"/>
        <UniformGrid Columns="3" IsVisible="{Binding IsBalance}">
         <StackPanel Margin="0,4,8,4"><TextBlock Text="Work in progress" TextWrapping="Wrap" FontSize="12"/><TextBlock Text="{Binding WipBalance}" FontWeight="SemiBold" TextWrapping="Wrap"/></StackPanel>
         <StackPanel Margin="0,4,8,4"><TextBlock Text="Awaiting launch" TextWrapping="Wrap" FontSize="12"/><TextBlock Text="{Binding AwaitingBalance}" FontWeight="SemiBold" TextWrapping="Wrap"/></StackPanel>
         <StackPanel Margin="0,4,0,4"><TextBlock Text="Unlaunched total" TextWrapping="Wrap" FontSize="12"/><TextBlock Text="{Binding TotalBalance}" FontWeight="SemiBold" TextWrapping="Wrap"/></StackPanel>
        </UniformGrid>
        <TextBlock Text="{Binding HistoryCaption}" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <charts:LivePerformanceTrendChart IsVisible="{Binding IsPeriod}" Series="{Binding Trend}" Unit="{Binding Unit}" NumberFormat="{Binding NumberFormat}" SeriesBrush="{DynamicResource FlowPurple}" SamplesOnly="True" Height="{Binding #Dashboard.ChartHeight}"/>
        <StackPanel IsVisible="{Binding IsBalance}" Spacing="3">
         <WrapPanel><TextBlock Text="● WIP   " Foreground="{DynamicResource FlowAccent}"/><TextBlock Text="● Awaiting launch   " Foreground="{DynamicResource FlowWarning}"/><TextBlock Text="● Unlaunched total" Foreground="{DynamicResource FlowPurple}"/></WrapPanel>
         <charts:LaunchCostChart History="{Binding ExplorerBalanceHistory}" UnlaunchedOnly="True" Height="{Binding #Dashboard.ChartHeight}"/>
        </StackPanel>
        <Expander Header="How it's calculated" HorizontalAlignment="Stretch"><StackPanel Spacing="6">
         <TextBlock Text="{Binding ExplorerDescription}" TextWrapping="Wrap"/>
         <TextBlock Text="{Binding Kind}" TextWrapping="Wrap"/>
         <TextBlock Text="{Binding Change}" TextWrapping="Wrap"/>
         <Button Content="Open KPI guide" Click="OpenMetricGuide" HorizontalAlignment="Left"/>
        </StackPanel></Expander>
        <Expander Header="Data limitations" HorizontalAlignment="Stretch"><TextBlock Text="{Binding Limitations}" TextWrapping="Wrap"/></Expander>
       </StackPanel></DataTemplate></ContentControl.ContentTemplate></ContentControl>
       </Grid>
       </StackPanel>
       <StackPanel IsVisible="{Binding CompareScenarios}" Spacing="6">
        <TextBlock Text="{Binding GuidedTitle}" FontWeight="Bold" TextWrapping="Wrap"/>
        <TextBlock Text="{Binding ScenarioStatus}" TextWrapping="Wrap" FontSize="12"/>
        <StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="New evaluation days"/><ComboBox ItemsSource="{Binding EvaluationPeriods}" SelectedItem="{Binding EvaluationDays}"/></StackPanel>
        <Button Content="Start staffing experiment…" Command="{Binding BeginGuidedCommand}"/>
        <TextBlock Text="Existing B5.1 baseline; LIVE advances only when you resume or step. One staffing variable. Shared checkpoint RNG, but random events may diverge after a change." TextWrapping="Wrap" FontSize="12"/>
        <ComboBox Name="ScenarioMetricPicker" ItemsSource="{Binding ScenarioOptions}" SelectedItem="{Binding ScenarioKpi}" HorizontalAlignment="Stretch" AutomationProperties.Name="Scenario KPI"><ComboBox.ItemTemplate><DataTemplate x:DataType="app:TeamKpiDefinition"><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
        <TextBlock Text="{Binding ScenarioKpi.Description}" TextWrapping="Wrap" FontSize="12"/>
        <TextBlock Text="Evaluation-to-date values · same scale. Hover for values and Δ." TextWrapping="Wrap" FontSize="12"/>
        <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="● Baseline" Foreground="{DynamicResource FlowAccent}"/><TextBlock Text="■ LIVE intervention" Foreground="{DynamicResource FlowPurple}"/></StackPanel>
        <charts:LivePerformanceTrendChart Series="{Binding ScenarioBaseline}" ComparisonSeries="{Binding ScenarioIntervention}" Unit="{Binding ScenarioUnit}" NumberFormat="{Binding ScenarioNumberFormat}" SamplesOnly="True" Height="{Binding #Dashboard.ChartHeight}"/>
        <TextBlock Text="Matched period summary · Δ = intervention − baseline" TextWrapping="Wrap" FontSize="12"/>
        <ItemsControl ItemsSource="{Binding ScenarioRows}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:ScenarioKpiDisplayRow"><StackPanel Margin="0,3">
         <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12"/><TextBlock Text="{Binding Unit}" FontSize="12"/>
         <Grid ColumnDefinitions="*,*,*"><StackPanel><TextBlock Text="Baseline" FontSize="12"/><TextBlock Text="{Binding Baseline}" FontSize="12"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Intervention" FontSize="12"/><TextBlock Text="{Binding Intervention}" FontSize="12"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Δ" FontSize="12"/><TextBlock Text="{Binding Difference}" FontSize="12"/></StackPanel></Grid>
        </StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        <TextBlock Text="{Binding ScenarioEconomics}" TextWrapping="Wrap" FontSize="12"/>
       </StackPanel>
      </StackPanel>
     </ScrollViewer>
    </Border>
    <Border Name="CardStrip">
    <ItemsControl ItemsSource="{Binding DisplayCards}">
     <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
     <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:KpiCard">
      <Button Classes="compactKpi" Cursor="Hand" Click="OpenExplorerClicked" Padding="0" Background="Transparent" AutomationProperties.Name="{Binding Name}"><Border Background="{DynamicResource FlowPanel}" BorderBrush="{Binding SelectionBorder}" BorderThickness="2" CornerRadius="4" Padding="5" Width="{Binding #Dashboard.CardWidth}" MinHeight="68" Margin="0,0,6,3" ToolTip.Tip="{Binding Help}">
       <StackPanel Spacing="1">
        <TextBlock MinHeight="26" Text="{Binding Name}" Foreground="{DynamicResource FlowSecondary}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <WrapPanel MinHeight="28"><TextBlock Margin="0,0,5,0" MaxWidth="{Binding $parent[StackPanel].Bounds.Width}" TextWrapping="Wrap" Text="{Binding Value}" Foreground="{DynamicResource FlowText}" FontWeight="Bold" FontSize="21"/><TextBlock Text="{Binding Unit}" Foreground="{DynamicResource FlowSecondary}" FontSize="12" VerticalAlignment="Center"/></WrapPanel>
       </StackPanel>
      </Border></Button>
     </DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
   </Border>
  </StackPanel>
 </Border>
</UserControl>
