<Window xmlns="https://github.com/avaloniaui" xmlns:charts="using:Simulation.UI.Controls" xmlns:views="using:Simulation.UI.Views" xmlns:vm="using:Simulation.UI.ViewModels" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Simulation.UI.Views.MainWindow" x:DataType="vm:MainWindowViewModel" Title="Software Development Simulation" Width="1240" Height="900" MinWidth="960" MinHeight="680" Background="#F4F4F0">
 <Window.Resources>
  <vm:PresentationLabels x:Key="HumanLabel" />
  <DataTemplate x:Key="ChangeField" x:DataType="vm:SimpleChangeField">
   <Grid ColumnDefinitions="240,100,140" Margin="0,6" ToolTip.Tip="{Binding Help}">
    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
    <TextBlock Grid.Column="1" Text="{Binding Current}" VerticalAlignment="Center" />
    <TextBox Grid.Column="2" Text="{Binding Value, Mode=TwoWay}" AutomationProperties.Name="{Binding Label}" />
   </Grid>
  </DataTemplate>
  <DataTemplate x:Key="ResultCard" x:DataType="vm:MetricRow">
   <Border Background="White" Padding="22" Margin="0,0,16,16" Width="350" MinHeight="136" CornerRadius="6" ToolTip.Tip="{Binding Explanation}">
    <StackPanel Spacing="10">
     <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
     <TextBlock Text="{Binding Value}" FontSize="23" TextWrapping="Wrap" />
    </StackPanel>
   </Border>
  </DataTemplate>
  <DataTemplate x:Key="CompareCard" x:DataType="vm:SimpleMetric">
   <Border Background="White" Padding="18" Margin="0,0,16,16" Width="350" MinHeight="190" CornerRadius="6" ToolTip.Tip="{Binding Explanation}">
    <StackPanel Spacing="8">
     <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
     <Grid ColumnDefinitions="*,16,*">
      <StackPanel>
       <TextBlock Text="Before" Classes="note" />
       <TextBlock Text="{Binding Before}" FontSize="19" TextWrapping="Wrap" />
      </StackPanel>
      <StackPanel Grid.Column="2">
       <TextBlock Text="After" Classes="note" />
       <TextBlock Text="{Binding After}" FontSize="19" TextWrapping="Wrap" />
      </StackPanel>
     </Grid>
     <TextBlock Text="{Binding Difference, StringFormat='Change: {0}'}" IsVisible="{Binding HasDifference}" TextWrapping="Wrap" />
    </StackPanel>
   </Border>
  </DataTemplate>
 </Window.Resources>
 <Window.Styles>
  <Style Selector="Button">
   <Setter Property="Padding" Value="14,10" />
   <Setter Property="Margin" Value="0,0,8,6" />
  </Style>
  <Style Selector="TextBlock.section">
   <Setter Property="FontSize" Value="18" />
   <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.note">
   <Setter Property="FontSize" Value="12" />
   <Setter Property="Foreground" Value="#526279" />
   <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="Border.card">
   <Setter Property="Background" Value="White" />
   <Setter Property="Padding" Value="18" />
   <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="TextBlock.page">
   <Setter Property="FontSize" Value="25" />
   <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <StyleInclude Source="/Styles/LiveVisualStyles.axaml"/>
  <StyleInclude Source="/Styles/ProductVisualStyles.axaml"/>
 </Window.Styles>
 <Grid RowDefinitions="64,*" DataContext="{Binding Simple}" x:DataType="vm:SimpleWorkflowViewModel">
  <Border Background="#111111" Padding="18,0">
   <Grid ColumnDefinitions="Auto,*,Auto">
    <Button Name="NavigationToggle" Content="≡" Click="ToggleNavigation" Classes="headerButton" FontSize="24" ToolTip.Tip="Show or hide navigation" AutomationProperties.Name="Toggle navigation" VerticalAlignment="Center"/>
    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
     <Border Background="#FFEB00" CornerRadius="3" Padding="8,4"><TextBlock Text="FLOW" Foreground="#111111" FontWeight="Bold" FontSize="18"/></Border>
     <StackPanel><TextBlock Name="ApplicationTitle" Text="Software Development Simulation" Foreground="White" FontWeight="SemiBold" FontSize="16"/><TextBlock Text="EXPLORE · OBSERVE · IMPROVE" Foreground="#BABABA" FontSize="10" LetterSpacing="2"/></StackPanel>
    </StackPanel>
    <Button Grid.Column="2" Content="Help  ?" Classes="headerButton" VerticalAlignment="Center" AutomationProperties.Name="Simulation help">
     <Button.Flyout><Flyout><StackPanel Spacing="8" MaxWidth="340"><TextBlock Text="Work with the flow" FontWeight="Bold" FontSize="18"/><TextBlock Text="Start a Live session, watch the queues and pause to change your team or working assumptions. Changes take effect on the next simulated day." TextWrapping="Wrap"/><TextBlock Text="Scenarios runs a separate simulation. Compare and Explore help investigate alternatives. Leaving Live pauses the current session." TextWrapping="Wrap"/><TextBlock Text="Yellow identifies controls. Orange and red queue highlights indicate accumulation; inspect their tooltips for the numbers." TextWrapping="Wrap"/></StackPanel></Flyout></Button.Flyout>
    </Button>
   </Grid>
  </Border>
  <Grid Grid.Row="1" ColumnDefinitions="Auto,*">
   <Border Name="Sidebar" Width="160" Background="#FFEB00" Padding="10,20,10,16">
    <Grid RowDefinitions="Auto,*,Auto">
     <StackPanel Name="PrimaryNavigation" Spacing="5">
      <TextBlock Text="WORKSPACE" FontSize="10" FontWeight="Bold" LetterSpacing="2" Margin="10,0,0,14"/>
      <Button Content="01   Live" Command="{Binding OpenLiveCommand}" Classes="sideNav" Classes.selected="{Binding LiveVisible}" AutomationProperties.Name="Navigate Live"/>
      <Button Content="02   Scenarios" Command="{Binding OpenRunCommand}" Classes="sideNav" Classes.selected="{Binding RunVisible}" AutomationProperties.Name="Navigate Scenarios"/>
      <Button Content="03   Compare" Command="{Binding OpenChangesCommand}" Classes="sideNav" Classes.selected="{Binding AnalyzeCompareVisible}" AutomationProperties.Name="Navigate Compare"/>
      <Button Content="04   Results" Command="{Binding ResultsCommand}" IsEnabled="{Binding Owner.HasResults}" Classes="sideNav" Classes.selected="{Binding ResultsVisible}" AutomationProperties.Name="Navigate Results"/>
      <Border Height="1" Background="#C9B900" Margin="10,12"/>
      <Button Content="Explore" Command="{Binding OpenExploreCommand}" Classes="sideNav" Classes.selected="{Binding ExploreVisible}" AutomationProperties.Name="Navigate Explore"/>
      <Button Content="Experiments" Command="{Binding OpenExperimentsCommand}" Classes="sideNav" Classes.selected="{Binding ExperimentsVisible}" AutomationProperties.Name="Navigate Experiments"/>
     </StackPanel>
     <StackPanel Grid.Row="2" Spacing="12">
      <Button Content="Settings" Command="{Binding AdvancedCommand}" Classes="sideNav" Classes.selected="{Binding AdvancedVisible}" AutomationProperties.Name="Navigate Advanced" ToolTip.Tip="Advanced settings, reproducibility and diagnostics"/>
      <TextBlock Text="A model for learning.&#10;Explore the trade-offs." TextWrapping="Wrap" FontSize="11" Margin="10,0" Foreground="#4F4A00"/>
     </StackPanel>
    </Grid>
   </Border>
   <Grid Name="Workspace" Grid.Column="1" Classes.compactLive="{Binding LiveVisible}" RowDefinitions="0,0,Auto,*,Auto" Margin="18,14">
  <StackPanel Grid.Row="2" IsVisible="{Binding AnalyzeVisible}" Spacing="6" Margin="0,0,0,12">
   <TextBlock Text="Analyze · investigate with independent scenario runs; your Live session stays paused." Classes="note" />
   <WrapPanel>
    <Button Content="Compare" Command="{Binding OpenChangesCommand}" Classes.primary="{Binding AnalyzeCompareVisible}" AutomationProperties.Name="Analyze Compare" />
    <Button Content="Explore" Command="{Binding OpenExploreCommand}" Classes.primary="{Binding ExploreVisible}" AutomationProperties.Name="Analyze Explore" />
    <Button Content="Experiments" Command="{Binding OpenExperimentsCommand}" Classes.primary="{Binding ExperimentsVisible}" AutomationProperties.Name="Analyze Experiments" />
   </WrapPanel>
  </StackPanel>
  <Grid Grid.Row="3">
   <Grid IsVisible="{Binding LiveVisible}"><views:LiveView DataContext="{Binding Live}" /></Grid>
   <ScrollViewer HorizontalScrollBarVisibility="Auto" IsVisible="{Binding HomeVisible}">
    <StackPanel MaxWidth="820" HorizontalAlignment="Left" Spacing="20" Margin="12,24">
     <TextBlock Text="What do you want to learn?" Classes="page" />
     <TextBlock Text="Explore how capacity, work flow, queues and quality interact in a software development team." TextWrapping="Wrap" FontSize="16" />
     <StackPanel Spacing="5">
      <Button Content="Run a simulation" Command="{Binding OpenRunCommand}" Classes="primary" HorizontalAlignment="Left" />
      <TextBlock Text="See how work moves through a development team." />
     </StackPanel>
     <StackPanel Spacing="5">
      <Button Content="Change something and compare" Command="{Binding OpenChangesCommand}" HorizontalAlignment="Left" />
      <TextBlock Text="Try a change to team size, capacity, work or quality." />
     </StackPanel>
     <StackPanel Spacing="5">
      <Button Content="Explore a parameter" Command="{Binding OpenExploreCommand}" HorizontalAlignment="Left" />
      <TextBlock Text="See what happens when one part of the system changes." />
     </StackPanel>
     <StackPanel Spacing="5">
      <Button Content="Start Live Simulation" Command="{Binding OpenLiveCommand}" HorizontalAlignment="Left" />
      <TextBlock Text="Watch work move through the system and make changes while it runs." />
     </StackPanel>
     <StackPanel IsVisible="{Binding Owner.HasResults}" Spacing="6">
      <TextBlock Text="Recent simulation" Classes="section" />
      <WrapPanel>
       <Button Content="View Results" Command="{Binding ResultsCommand}" />
       <Button Content="View Flow" Command="{Binding FlowCommand}" />
      </WrapPanel>
     </StackPanel>
    </StackPanel>
   </ScrollViewer>
   <ScrollViewer HorizontalScrollBarVisibility="Auto" IsVisible="{Binding RunVisible}">
    <StackPanel MaxWidth="900" HorizontalAlignment="Left" Spacing="18">
     <TextBlock Text="See how work flows through your team" Classes="page" />
     <StackPanel Orientation="Horizontal" Spacing="12">
      <TextBlock Text="Start from" VerticalAlignment="Center" />
      <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding Preset, Mode=TwoWay}" Width="260" IsEnabled="{Binding CanEdit}" />
     </StackPanel>
     <Grid ColumnDefinitions="360,40,360" IsEnabled="{Binding CanEdit}">
      <StackPanel Spacing="10">
       <TextBlock Text="Team" Classes="section" />
       <Grid ColumnDefinitions="*,120">
        <TextBlock Text="Developers" VerticalAlignment="Center" />
        <TextBox Grid.Column="1" Text="{Binding Owner.NumberOfDevelopers, Mode=TwoWay}" AutomationProperties.Name="Run Developers" />
       </Grid>
       <Grid ColumnDefinitions="*,120">
        <TextBlock Text="Testers" VerticalAlignment="Center" />
        <TextBox Grid.Column="1" Text="{Binding Owner.NumberOfTesters, Mode=TwoWay}" AutomationProperties.Name="Run Testers" />
       </Grid>
       <TextBlock Text="Flow" Classes="section" Margin="0,16,0,0" />
       <Grid ColumnDefinitions="*,120">
        <TextBlock Text="Development WIP" VerticalAlignment="Center" ToolTip.Tip="{x:Static vm:FlowPresentation.DevelopmentWipHelp}" />
        <TextBox Grid.Column="1" Text="{Binding Owner.DevelopmentWipLimit, Mode=TwoWay}" ToolTip.Tip="Maximum number of active Development items. Waiting queues are separate." />
       </Grid>
       <Grid ColumnDefinitions="*,120">
        <TextBlock Text="Testing WIP" VerticalAlignment="Center" />
        <TextBox Grid.Column="1" Text="{Binding Owner.TestingWipLimit, Mode=TwoWay}" ToolTip.Tip="Maximum number of active Testing items. Waiting queues are separate." />
       </Grid>
      </StackPanel>
      <StackPanel Grid.Column="2" Spacing="10">
       <TextBlock Text="Work" Classes="section" />
       <Grid ColumnDefinitions="*,120">
        <TextBlock Text="Work Items" VerticalAlignment="Center" />
        <TextBox Grid.Column="1" Text="{Binding Owner.NumberOfWorkItems, Mode=TwoWay}" />
       </Grid>
       <Grid ColumnDefinitions="*,120" IsVisible="{Binding Owner.DevelopmentDistribution.IsFixed}">
        <TextBlock Text="Development Effort" VerticalAlignment="Center" />
        <TextBox Grid.Column="1" Text="{Binding Owner.DevelopmentEffort, Mode=TwoWay}" ToolTip.Tip="Abstract work needed per item, not hours or elapsed days." />
       </Grid>
       <TextBlock IsVisible="{Binding Owner.DevelopmentDistribution.IsTriangular}" Text="Development effort varies · inspect More settings." Classes="note" />
       <Grid ColumnDefinitions="*,120" IsVisible="{Binding Owner.TestingDistribution.IsFixed}">
        <TextBlock Text="Testing Effort" VerticalAlignment="Center" />
        <TextBox Grid.Column="1" Text="{Binding Owner.TestingEffort, Mode=TwoWay}" ToolTip.Tip="Testing work needed per item." />
       </Grid>
       <TextBlock IsVisible="{Binding Owner.TestingDistribution.IsTriangular}" Text="Testing effort varies · inspect More settings." Classes="note" />
       <TextBlock Text="Quality" Classes="section" Margin="0,16,0,0" />
       <CheckBox Content="Defects enabled" IsChecked="{Binding Owner.DefectsEnabled, Mode=TwoWay}" ToolTip.Tip="Uses the current defect probabilities and rework settings in More settings." />
      </StackPanel>
     </Grid>
     <Expander Header="More settings" HorizontalAlignment="Stretch">
      <views:MoreSettingsView DataContext="{Binding Owner}" />
     </Expander>
     <Button Content="Run Simulation" Command="{Binding RunCommand}" Classes="primary" HorizontalAlignment="Left" />
    </StackPanel>
   </ScrollViewer>
   <ScrollViewer HorizontalScrollBarVisibility="Auto" IsVisible="{Binding ResultsVisible}">
    <StackPanel MaxWidth="900" HorizontalAlignment="Left" Spacing="16">
     <TextBlock Text="What happened?" Classes="page" />
     <ItemsControl ItemsSource="{Binding RunCards}" ItemTemplate="{StaticResource ResultCard}">
      <ItemsControl.ItemsPanel>
       <ItemsPanelTemplate>
        <WrapPanel />
       </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
     </ItemsControl>
     <WrapPanel>
      <Button Content="View Flow" Command="{Binding FlowCommand}" />
      <Button Content="Change &amp; Compare" Command="{Binding OpenChangesCommand}" Classes="primary" />
     </WrapPanel>
     <Expander Header="Show Details" HorizontalAlignment="Stretch">
      <views:DetailedResultView DataContext="{Binding Owner}" Height="620" />
     </Expander>
    </StackPanel>
   </ScrollViewer>
   <Grid IsVisible="{Binding FlowVisible}" RowDefinitions="Auto,*">
    <Button Content="Back to Results" Command="{Binding ResultsCommand}" HorizontalAlignment="Left" />
    <views:ResultFlowView Grid.Row="1" DataContext="{Binding Owner}" />
   </Grid>
   <ScrollViewer HorizontalScrollBarVisibility="Auto" IsVisible="{Binding ChangesVisible}">
    <StackPanel MaxWidth="900" HorizontalAlignment="Left" Spacing="12">
     <TextBlock Text="Change something and see what happens" Classes="page" />
     <StackPanel Orientation="Horizontal" Spacing="12">
      <TextBlock Text="Starting point" VerticalAlignment="Center" />
      <ComboBox Width="200" ItemsSource="{Binding StartingPoints}" SelectedItem="{Binding StartingPoint, Mode=TwoWay}" IsEnabled="{Binding CanEdit}" />
     </StackPanel>
     <TextBlock Text="What do you want to change?" FontSize="18" />
     <StackPanel IsEnabled="{Binding CanEdit}" Spacing="8">
      <Grid ColumnDefinitions="240,100,140">
       <TextBlock Text="Team" FontWeight="SemiBold" />
       <TextBlock Grid.Column="1" Text="Current" />
       <TextBlock Grid.Column="2" Text="Try" />
      </Grid>
      <ItemsControl ItemsSource="{Binding TeamChanges}" ItemTemplate="{StaticResource ChangeField}" />
      <TextBlock Text="Flow" FontWeight="SemiBold" />
      <ItemsControl ItemsSource="{Binding FlowChanges}" ItemTemplate="{StaticResource ChangeField}" />
      <Grid ColumnDefinitions="240,100,140">
       <TextBlock Text="Defects" VerticalAlignment="Center" />
       <TextBlock Grid.Column="1" Text="{Binding CurrentDefects}" VerticalAlignment="Center" />
       <CheckBox Grid.Column="2" Content="Enabled" IsChecked="{Binding Try.DefectsEnabled, Mode=TwoWay}" />
      </Grid>
      <Expander Header="More things to change" HorizontalAlignment="Stretch">
       <StackPanel Spacing="12">
        <TextBlock Text="Availability · percentage of nominal capacity" Classes="note" />
        <ItemsControl ItemsSource="{Binding CapacityChanges}" ItemTemplate="{StaticResource ChangeField}" />
        <views:MoreSettingsView DataContext="{Binding Try}" />
       </StackPanel>
      </Expander>
     </StackPanel>
     <Button Content="Run Comparison" Command="{Binding CompareCommand}" Classes="primary" HorizontalAlignment="Left" />
    </StackPanel>
   </ScrollViewer>
   <ScrollViewer HorizontalScrollBarVisibility="Auto" IsVisible="{Binding ComparisonVisible}">
    <StackPanel MaxWidth="900" HorizontalAlignment="Left" Spacing="14">
     <Button Content="Back to Changes" Command="{Binding BackChangesCommand}" HorizontalAlignment="Left" />
     <TextBlock Text="{Binding ChangesTitle}" Classes="page" />
     <ItemsControl ItemsSource="{Binding Pair.ChangedParameters}">
      <ItemsControl.ItemTemplate>
       <DataTemplate x:DataType="vm:ChangedParameter">
        <Grid ColumnDefinitions="260,*" Margin="0,4">
         <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
         <TextBlock Grid.Column="1" Text="{Binding Change}" />
        </Grid>
       </DataTemplate>
      </ItemsControl.ItemTemplate>
     </ItemsControl>
     <ItemsControl ItemsSource="{Binding CompareCards}" ItemTemplate="{StaticResource CompareCard}">
      <ItemsControl.ItemsPanel>
       <ItemsPanelTemplate>
        <WrapPanel />
       </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
     </ItemsControl>
     <TextBlock Text="What happened to the flow?" Classes="section" />
     <StackPanel IsVisible="{Binding HasFlowObservation}" Spacing="4">
      <TextBlock Text="Flow observation" FontWeight="SemiBold" />
      <TextBlock Text="{Binding FlowObservation}" TextWrapping="Wrap" />
     </StackPanel>
     <Grid ColumnDefinitions="240,*,*">
      <TextBlock Grid.Column="1" Text="Before" FontWeight="SemiBold" />
      <TextBlock Grid.Column="2" Text="After" FontWeight="SemiBold" />
     </Grid>
     <TextBlock Text="{Binding FlowCaption}" Classes="note" />
     <Slider Minimum="1" Maximum="{Binding Pair.FlowLastDay}" Value="{Binding Pair.FlowDay, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" />
     <ItemsControl ItemsSource="{Binding Pair.SimpleFlow}">
      <ItemsControl.ItemTemplate>
       <DataTemplate x:DataType="vm:FlowComparisonRow">
        <Grid ColumnDefinitions="240,*,16,*" Margin="0,7">
         <TextBlock Text="{Binding Name}" />
         <StackPanel Grid.Column="1">
          <TextBlock Text="{Binding Before}" />
          <ProgressBar Value="{Binding Before}" Maximum="{Binding Scale}" Height="8" Foreground="#768FA6" />
         </StackPanel>
         <StackPanel Grid.Column="3">
          <TextBlock Text="{Binding After}" />
          <ProgressBar Value="{Binding After}" Maximum="{Binding Scale}" Height="8" Foreground="#768FA6" />
         </StackPanel>
        </Grid>
       </DataTemplate>
      </ItemsControl.ItemTemplate>
     </ItemsControl>
     <Expander Header="Show More Results" HorizontalAlignment="Stretch">
      <ItemsControl ItemsSource="{Binding MoreComparisonResults}">
       <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:CompareTextRow">
         <Grid ColumnDefinitions="300,*" Margin="0,8">
          <TextBlock Text="{Binding Label}" />
          <ItemsControl Grid.Column="1" ItemsSource="{Binding Cells}">
           <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
             <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
           </ItemsControl.ItemsPanel>
           <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:CompareTextCell">
             <TextBlock Text="{Binding Text}" Width="180" TextWrapping="Wrap" />
            </DataTemplate>
           </ItemsControl.ItemTemplate>
          </ItemsControl>
         </Grid>
        </DataTemplate>
       </ItemsControl.ItemTemplate>
      </ItemsControl>
     </Expander>
     <Button Content="Advanced Comparison" Command="{Binding AdvancedPairCommand}" HorizontalAlignment="Left" Background="Transparent" />
    </StackPanel>
   </ScrollViewer>
   <ScrollViewer HorizontalScrollBarVisibility="Auto" IsVisible="{Binding ExploreVisible}">
    <StackPanel MaxWidth="850" HorizontalAlignment="Left" Spacing="14">
     <TextBlock Text="Explore a parameter" Classes="page" />
     <TextBlock Text="See what happens when one part of the system changes." />
     <Grid ColumnDefinitions="350,24,350" RowDefinitions="Auto,12,Auto">
      <StackPanel Spacing="6" Grid.Row="0" Grid.Column="0">
       <TextBlock Text="What do you want to change?" />
       <ComboBox ItemsSource="{Binding ExploreParameters}" SelectedItem="{Binding Explore.Parameter, Mode=TwoWay}" Width="300">
        <ComboBox.ItemTemplate>
         <DataTemplate x:CompileBindings="False">
          <TextBlock Text="{Binding Converter={StaticResource HumanLabel}}" />
         </DataTemplate>
        </ComboBox.ItemTemplate>
       </ComboBox>
      </StackPanel>
      <StackPanel Spacing="6" Grid.Row="0" Grid.Column="2">
       <TextBlock Text="Values" />
       <TextBox Text="{Binding Explore.Values, Mode=TwoWay}" AutomationProperties.Name="Analyze parameter values" Width="360" HorizontalAlignment="Left" />
      </StackPanel>
      <StackPanel Spacing="6" Grid.Row="2" Grid.Column="0">
       <TextBlock Text="What do you want to observe?" />
       <ComboBox ItemsSource="{Binding ExploreMetrics}" SelectedItem="{Binding Explore.Metric, Mode=TwoWay}" Width="300">
        <ComboBox.ItemTemplate>
         <DataTemplate x:CompileBindings="False">
          <TextBlock Text="{Binding Converter={StaticResource HumanLabel}}" />
         </DataTemplate>
        </ComboBox.ItemTemplate>
       </ComboBox>
      </StackPanel>
      <Button Content="Explore" Command="{Binding ExploreCommand}" Classes="primary" HorizontalAlignment="Left" Grid.Row="2" Grid.Column="2" VerticalAlignment="Bottom" />
     </Grid>
     <TextBlock Text="{Binding ExploreStatus}" Classes="note" />
     <TextBlock Text="{Binding ExploreTitle}" Classes="section" IsVisible="{Binding HasExploreResults}" />
     <charts:SensitivityChart IsVisible="{Binding HasExploreResults}" Points="{Binding Explore.Points}" Metric="{Binding Explore.Metric}" Height="270" Width="820" />
     <Expander Header="Show Data" IsVisible="{Binding HasExploreResults}" HorizontalAlignment="Stretch">
      <ItemsControl ItemsSource="{Binding Explore.Rows}">
       <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:SensitivityTableRow">
         <Grid ColumnDefinitions="*,*,*" Margin="0,5">
          <TextBlock Text="{Binding Value}" />
          <TextBlock Grid.Column="1" Text="{Binding Selected}" />
          <TextBlock Grid.Column="2" Text="{Binding Delta}" />
         </Grid>
        </DataTemplate>
       </ItemsControl.ItemTemplate>
      </ItemsControl>
     </Expander>
     <Expander Header="Advanced Analysis · more parameters, metrics and uncertainty" HorizontalAlignment="Stretch">
      <views:SensitivityView DataContext="{Binding Explore}" />
     </Expander>
    </StackPanel>
   </ScrollViewer>
   <Grid IsVisible="{Binding ExperimentsVisible}"><views:CompareView DataContext="{Binding Owner.Compare}" /></Grid>
   <Grid IsVisible="{Binding AdvancedVisible}" RowDefinitions="Auto,*">
    <Expander Header="Current simple comparison · specialist controls" IsVisible="{Binding ShowPairInAdvanced}" MaxHeight="600" HorizontalAlignment="Stretch">
     <views:CompareView DataContext="{Binding Pair}" />
    </Expander>
    <views:AdvancedWorkspace Grid.Row="1" DataContext="{Binding Owner}" />
   </Grid>
  </Grid>
  <StackPanel Grid.Row="4" Spacing="5">
   <TextBlock Text="{Binding Status}" Classes="note" />
   <Button Content="Cancel" Command="{Binding CancelCommand}" IsVisible="{Binding IsBusy}" HorizontalAlignment="Left" />
  </StackPanel>
   </Grid>
  </Grid>
 </Grid>
</Window>
