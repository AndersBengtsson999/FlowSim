<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:Simulation.UI.ViewModels" xmlns:views="using:Simulation.UI.Views" x:Class="Simulation.UI.Views.LiveSettingsView" x:DataType="vm:MainWindowViewModel"><StackPanel Spacing="12"><Grid ColumnDefinitions="*,100"><TextBlock Text="Code Review WIP" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding CodeReviewWipLimit, Mode=TwoWay}" AutomationProperties.Name="Live Code Review WIP" /></Grid>
<Grid ColumnDefinitions="*,100"><TextBlock Text="Rework WIP" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding ReworkWipLimit, Mode=TwoWay}" AutomationProperties.Name="Live Rework WIP" /></Grid>
</StackPanel></UserControl>