<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <!-- Product identity is separate from the existing queue severity palette. -->
 <Style Selector="TextBlock"><Setter Property="Foreground" Value="{DynamicResource FlowText}"/></Style>
 <Style Selector="TextBlock.note, TextBlock.liveSecondary, TextBlock.metricLabel"><Setter Property="Foreground" Value="{DynamicResource FlowSecondary}"/></Style>
 <Style Selector="TextBlock.section, TextBlock.liveSection"><Setter Property="Foreground" Value="{DynamicResource FlowText}"/></Style>
 <Style Selector="Border.card, Border.livePanel"><Setter Property="BorderBrush" Value="{DynamicResource FlowBorder}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="5"/></Style>
 <Style Selector="Border.instrument"><Setter Property="Background" Value="{DynamicResource FlowPanel}"/><Setter Property="BorderBrush" Value="{DynamicResource FlowBorder}"/><Setter Property="BorderThickness" Value="1,1,1,3"/><Setter Property="Padding" Value="12,8"/><Setter Property="Margin" Value="0,0,6,6"/><Setter Property="CornerRadius" Value="4"/></Style>
 <Style Selector="Border.sectionBand"><Setter Property="Background" Value="{DynamicResource FlowElevated}"/><Setter Property="Padding" Value="12,7"/><Setter Property="CornerRadius" Value="4"/></Style>
 <Style Selector="Button"><Setter Property="CornerRadius" Value="4"/></Style>
 <Style Selector="Button.primary, WrapPanel#LiveToolbar Button.primary"><Setter Property="Background" Value="{DynamicResource FlowAccent}"/><Setter Property="Foreground" Value="{DynamicResource FlowOnAccent}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="BorderBrush" Value="{DynamicResource FlowBorder}"/><Setter Property="BorderThickness" Value="1"/></Style>
 <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource FlowAccent}"/><Setter Property="Foreground" Value="{DynamicResource FlowOnAccent}"/></Style>
 <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource FlowAccent}"/><Setter Property="Foreground" Value="{DynamicResource FlowOnAccent}"/></Style>
 <Style Selector="Button.sideNav"><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Padding" Value="10,9"/><Setter Property="Margin" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="{DynamicResource FlowText}"/><Setter Property="FontSize" Value="14"/></Style>
 <Style Selector="Button.sideNav.selected"><Setter Property="Background" Value="{DynamicResource FlowSelected}"/><Setter Property="Foreground" Value="{DynamicResource FlowText}"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
 <Style Selector="Button.sideNav:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource FlowHover}"/><Setter Property="Foreground" Value="{DynamicResource FlowText}"/></Style>
 <Style Selector="Button.sideNav.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource FlowHover}"/><Setter Property="Foreground" Value="{DynamicResource FlowText}"/></Style>
 <Style Selector="Button.sideNav:disabled /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource FlowSecondary}"/></Style>
 <Style Selector="Button.headerButton"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource FlowText}"/><Setter Property="BorderBrush" Value="{DynamicResource FlowBorder}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Margin" Value="0,0,12,0"/><Setter Property="Padding" Value="12,7"/></Style>
 <Style Selector="Button.headerButton:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource FlowHover}"/><Setter Property="Foreground" Value="{DynamicResource FlowText}"/></Style>
 <Style Selector="Button:focus-visible /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="BorderBrush" Value="{DynamicResource FlowAccent}"/><Setter Property="BorderThickness" Value="2"/></Style>
 <Style Selector="ToggleButton.flowDisclosure.active"><Setter Property="Background" Value="{DynamicResource FlowElevated}"/></Style>
 <Style Selector="ToggleButton.flowDisclosure.completed"><Setter Property="Background" Value="{DynamicResource FlowCompleted}"/></Style>
 <Style Selector="ToggleButton.flowDisclosure.waiting"><Setter Property="Background" Value="{DynamicResource FlowPanel}"/></Style>
 <Style Selector="ToggleButton.flowDisclosure.queueAttention"><Setter Property="Background" Value="{DynamicResource QueueAttentionBrush}"/></Style>
 <Style Selector="ToggleButton.flowDisclosure.queueStrong"><Setter Property="Background" Value="{DynamicResource QueueStrongBrush}"/></Style>
 <Style Selector="ProgressBar.wipGauge"><Setter Property="Foreground" Value="{DynamicResource FlowText}"/><Setter Property="Background" Value="{DynamicResource FlowPanel}"/></Style>
 <Style Selector="Expander.liveAnalysis /template/ ToggleButton"><Setter Property="Background" Value="{DynamicResource FlowElevated}"/><Setter Property="Foreground" Value="{DynamicResource FlowOnAccent}"/></Style>
 <Style Selector="Expander#SetupSection"><Setter Property="Background" Value="{DynamicResource FlowPanel}"/><Setter Property="BorderBrush" Value="{DynamicResource FlowBorder}"/></Style>
</Styles>
