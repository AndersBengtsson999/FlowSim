<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Style Selector="Window"><Setter Property="Background" Value="{DynamicResource FlowApp}"/><Setter Property="Foreground" Value="{DynamicResource FlowText}"/><Setter Property="RequestedThemeVariant" Value="Dark"/></Style>
 <Style Selector="TextBlock"><Setter Property="Foreground" Value="{DynamicResource FlowText}"/></Style>
 <Style Selector="Button"><Setter Property="Background" Value="{DynamicResource FlowElevated}"/><Setter Property="Foreground" Value="{DynamicResource FlowText}"/><Setter Property="BorderBrush" Value="{DynamicResource FlowBorder}"/><Setter Property="CornerRadius" Value="4"/></Style>
 <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource FlowPanel}"/><Setter Property="Foreground" Value="{DynamicResource FlowMuted}"/></Style>
 <Style Selector="Button:focus-visible /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="BorderBrush" Value="{DynamicResource FlowAccent}"/><Setter Property="BorderThickness" Value="2"/></Style>
 <Style Selector="TextBox"><Setter Property="Background" Value="{DynamicResource FlowContent}"/><Setter Property="Foreground" Value="{DynamicResource FlowText}"/><Setter Property="BorderBrush" Value="{DynamicResource FlowBorder}"/><Setter Property="CornerRadius" Value="4"/></Style>
 <Style Selector="TextBox:focus /template/ Border#PART_BorderElement"><Setter Property="BorderBrush" Value="{DynamicResource FlowAccent}"/></Style>
 <Style Selector="ComboBox"><Setter Property="Background" Value="{DynamicResource FlowContent}"/><Setter Property="Foreground" Value="{DynamicResource FlowText}"/><Setter Property="BorderBrush" Value="{DynamicResource FlowBorder}"/><Setter Property="CornerRadius" Value="4"/></Style>
 <Style Selector="Expander"><Setter Property="Background" Value="{DynamicResource FlowPanel}"/><Setter Property="Foreground" Value="{DynamicResource FlowText}"/><Setter Property="BorderBrush" Value="{DynamicResource FlowBorder}"/></Style>
 <Style Selector="ToolTip"><Setter Property="Background" Value="{DynamicResource FlowElevated}"/><Setter Property="Foreground" Value="{DynamicResource FlowText}"/></Style>
 <Style Selector="Border.card"><Setter Property="Background" Value="{DynamicResource FlowPanel}"/><Setter Property="BorderBrush" Value="{DynamicResource FlowBorder}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="5"/></Style>
 <Style Selector="TextBlock.section"><Setter Property="Foreground" Value="{DynamicResource FlowText}"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
 <Style Selector="TextBlock.note"><Setter Property="Foreground" Value="{DynamicResource FlowSecondary}"/></Style>
 <Style Selector="Button.destructive"><Setter Property="Foreground" Value="{DynamicResource FlowError}"/><Setter Property="BorderBrush" Value="{DynamicResource FlowError}"/></Style>
 <Style Selector="Expander /template/ ToggleButton"><Setter Property="Background" Value="{DynamicResource FlowPanel}"/><Setter Property="Foreground" Value="{DynamicResource FlowText}"/></Style>
 <Style Selector="Expander /template/ ToggleButton:pointerover"><Setter Property="Background" Value="{DynamicResource FlowHover}"/></Style>
</Styles>
