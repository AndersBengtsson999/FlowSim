<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Styles.Resources>
  <SolidColorBrush x:Key="LiveInk">#203440</SolidColorBrush>
  <SolidColorBrush x:Key="LiveMuted">#61717E</SolidColorBrush>
  <SolidColorBrush x:Key="LiveLine">#DDE5EA</SolidColorBrush>
  <SolidColorBrush x:Key="LiveSurface">#FFFFFF</SolidColorBrush>
  <SolidColorBrush x:Key="LiveActive">#ECF2F6</SolidColorBrush>
  <SolidColorBrush x:Key="LiveWaiting">#F3F1ED</SolidColorBrush>
  <SolidColorBrush x:Key="LiveCompleted">#EEF3F2</SolidColorBrush>
  <Thickness x:Key="LivePanelPadding">10,6</Thickness>
  <Thickness x:Key="LiveControlPadding">10,5</Thickness>
  <CornerRadius x:Key="LiveRadius">4</CornerRadius>
 </Styles.Resources>
 <Style Selector="Grid.compactLive TextBlock#ApplicationTitle"><Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{StaticResource LiveMuted}"/></Style>
 <Style Selector="Grid.compactLive Grid#NavigationRow Button"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="14"/><Setter Property="Foreground" Value="{StaticResource LiveInk}"/><Setter Property="CornerRadius" Value="{StaticResource LiveRadius}"/></Style>
 <Style Selector="Grid.compactLive Grid#NavigationRow Button.primary"><Setter Property="Background" Value="#E0ECEF"/><Setter Property="Foreground" Value="#175E70"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
 <Style Selector="Grid.compactLive TextBlock.section, TextBlock.liveSection"><Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{StaticResource LiveInk}"/></Style>
 <Style Selector="TextBlock.metricLabel, TextBlock.liveSecondary"><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{StaticResource LiveMuted}"/></Style>
 <Style Selector="TextBlock.metricValue"><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{StaticResource LiveInk}"/></Style>
 <Style Selector="Border.livePanel"><Setter Property="Background" Value="{StaticResource LiveSurface}"/><Setter Property="Padding" Value="{StaticResource LivePanelPadding}"/><Setter Property="CornerRadius" Value="{StaticResource LiveRadius}"/></Style>
 <Style Selector="Border.toolbarSeparator"><Setter Property="Width" Value="1"/><Setter Property="Height" Value="20"/><Setter Property="Background" Value="{StaticResource LiveLine}"/><Setter Property="Margin" Value="4,0,10,0"/></Style>
 <Style Selector="WrapPanel#LiveToolbar Button"><Setter Property="Background" Value="#F8FAFB"/><Setter Property="Foreground" Value="{StaticResource LiveInk}"/><Setter Property="BorderBrush" Value="{StaticResource LiveLine}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="{StaticResource LiveControlPadding}"/><Setter Property="CornerRadius" Value="{StaticResource LiveRadius}"/></Style>
 <Style Selector="WrapPanel#LiveToolbar Button.primary"><Setter Property="Background" Value="#176A78"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/></Style>
 <Style Selector="WrapPanel#LiveToolbar Button.sessionReset"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="{StaticResource LiveMuted}"/></Style>
 <Style Selector="Expander#SetupSection"><Setter Property="BorderBrush" Value="{StaticResource LiveLine}"/><Setter Property="Background" Value="#F8FAFB"/><Setter Property="CornerRadius" Value="{StaticResource LiveRadius}"/></Style>
 <Style Selector="ToggleButton.flowDisclosure"><Setter Property="Background" Value="#F6F8FA"/><Setter Property="Foreground" Value="{StaticResource LiveInk}"/><Setter Property="Padding" Value="10,4"/><Setter Property="CornerRadius" Value="{StaticResource LiveRadius}"/></Style>
 <Style Selector="ToggleButton.flowDisclosure.active"><Setter Property="Background" Value="{StaticResource LiveActive}"/></Style>
 <Style Selector="ToggleButton.flowDisclosure.waiting"><Setter Property="Background" Value="{StaticResource LiveWaiting}"/></Style>
 <Style Selector="ToggleButton.flowDisclosure.completed"><Setter Property="Background" Value="{StaticResource LiveCompleted}"/></Style>
 <Style Selector="ToggleButton.flowDisclosure:checked /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.flowDisclosure:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
  <Setter Property="Background" Value="{Binding $parent[ToggleButton].Background}"/><Setter Property="Foreground" Value="{StaticResource LiveInk}"/>
 </Style>
 <Style Selector="ProgressBar.wipGauge"><Setter Property="Height" Value="3"/><Setter Property="MinHeight" Value="3"/><Setter Property="Width" Value="76"/><Setter Property="MinWidth" Value="0"/><Setter Property="HorizontalAlignment" Value="Left"/><Setter Property="Foreground" Value="#8198A6"/><Setter Property="Background" Value="#D8E2E8"/></Style>
 <Style Selector="Border.embeddedItem"><Setter Property="BorderBrush" Value="{StaticResource LiveLine}"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="Padding" Value="6,4"/><Setter Property="Margin" Value="0,0,12,2"/></Style>
 <Style Selector="ListBox#LiveFlow ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="Transparent"/></Style>
 <Style Selector="Grid.compactLive ComboBox"><Setter Property="CornerRadius" Value="{StaticResource LiveRadius}"/></Style>
 <Style Selector="Expander.liveAnalysis /template/ ToggleButton"><Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{StaticResource LiveInk}"/></Style>
</Styles>
